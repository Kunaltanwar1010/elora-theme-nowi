    "faq_home_elora": {
      "type": "faq-page",
      "blocks": {
        "faq_choose_size": {
          "type": "faq_item",
          "settings": {
            "question": "How do I choose the right size?",
            "answer": "<p>We recommend checking our Size Guide available on every product page before placing your order. If you’re between sizes or need help, feel free to contact us on WhatsApp—we’ll be happy to assist you.</p>"
          }
        },
        "faq_doesnt_fit": {
          "type": "faq_item",
          "settings": {
            "question": "What if the outfit doesn't fit me?",
            "answer": "<p>No worries! We offer easy size exchanges for eligible products. Simply raise an exchange request within the specified time after delivery, and we'll guide you through the process.</p>"
          }
        },
        "faq_shipping_time": {
          "type": "faq_item",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>We process all orders within 1–2 business days. Delivery usually takes 3–7 business days, depending on your location. You'll receive a tracking link once your order is shipped.</p>"
          }
        },
        "faq_track_order": {
          "type": "faq_item",
          "settings": {
            "question": "How can I track my order?",
            "answer": "<p>Once your order is shipped, we'll send you a tracking link via SMS, WhatsApp, or email. You can use it to check the real-time status of your shipment.</p>"
          }
        },
        "faq_exchange": {
          "type": "faq_item",
          "settings": {
            "question": "Can I exchange my order?",
            "answer": "<p>Yes, we offer easy size exchanges on eligible products. You can request an exchange within 7 days of delivery, provided the item is unused, unwashed, and has all original tags attached.</p>"
          }
        },
        "faq_contact": {
          "type": "faq_item",
          "settings": {
            "question": "How can I contact Elora Closet?",
            "answer": "<p>You can reach us via WhatsApp, email, or Instagram DM. Our customer support team is available to help with sizing, orders, exchanges, or any other queries.</p>"
          }
        }
      },
      "block_order": [
