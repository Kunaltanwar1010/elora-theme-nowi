{%- liquid
  assign collection_handle = section.settings.collection
  assign products_to_show = section.settings.products_to_show
  assign columns_mobile = section.settings.columns_mobile
  assign columns_desktop = section.settings.columns_desktop
  assign enable_pagination = section.settings.enable_pagination
  assign enable_infinite_scroll = section.settings.enable_infinite_scroll

  # Carousel mode reuses the "no pagination" branch below
  assign is_carousel = false
  if section.settings.layout == 'carousel'
    assign is_carousel = true
    assign enable_pagination = false
    assign enable_infinite_scroll = false
  endif

  assign card_gap = settings.modern_card_gap | default: 16

  # Storefront grid/carousel toggle needs the carousel markup in both states
  assign show_layout_toggle = section.settings.show_layout_toggle
  assign use_carousel_markup = false
  if is_carousel or show_layout_toggle
    assign use_carousel_markup = true
    assign enable_pagination = false
    assign enable_infinite_scroll = false
  endif

  if collection_handle != blank
    assign target_collection = collections[collection_handle]
  else
    assign target_collection = collection
  endif


  assign custom_title = section.settings.custom_title
  assign heading_font_size = section.settings.heading_font_size
  assign heading_font_weight = section.settings.heading_font_weight
  assign heading_text_transform = section.settings.heading_text_transform
  assign heading_alignment = section.settings.heading_alignment

  # Check if we're on a collection page template
  assign is_collection_page = false
  if template.name == 'collection'
    assign is_collection_page = true
  endif

  # Quick Buy settings (colors from global theme settings)
  assign enable_quick_buy = section.settings.enable_quick_buy
-%}

{{ 'component-quick-buy.css' | asset_url | stylesheet_tag }}
{{ 'component-collection-product-card-modern.css' | asset_url | stylesheet_tag }}
{{ 'component-desktop-sort-filter.css' | asset_url | stylesheet_tag }}
{%- comment -%} Collection scripts (moved from global theme.liquid — only needed on collection/search pages) {%- endcomment -%}
<script src="{{ 'collection-filter-ajax.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'collection-filter-ui.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'infinite-scroll.js' | asset_url }}" defer="defer"></script>

<div class="collection-grid-section px-4" data-section-id="{{ section.id }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="max-w-8xl mx-auto" style="max-width: var(--page-width);">

    {% if section.settings.show_collection_title %}
      {% assign display_title = custom_title | default: target_collection.title %}
      {% if display_title != blank %}
        <h2 class="pb-6 {{ heading_alignment }} {{ heading_text_transform }}"
            style="font-size: {{ heading_font_size }}px; font-weight: {{ heading_font_weight }}; color: {{ section.settings.heading_color }};">
          {{ display_title }}
        </h2>
      {% endif %}
    {% endif %}

    {% if section.settings.show_product_count and target_collection %}
      <p class="cg-count {{ heading_alignment }}">
        {{ target_collection.products_count }} {{ target_collection.products_count | pluralize: 'product', 'products' }}
      </p>
    {% endif %}

    {% if section.settings.show_collection_description and target_collection.description != blank %}
      <div class="text-gray-600 mb-8 max-w-3xl">
        {{ target_collection.description }}
      </div>
    {% endif %}

    {% if target_collection %}
      <!-- Product grid container -->
      <div class="collection-with-filters">
        <!-- PRODUCT GRID -->
        <div style="flex: 1; min-width: 0;">
          <!-- Active Filters Display (outside ProductGridContainer so it persists) -->
          {% if is_collection_page and target_collection.filters.size > 0 %}
          <div class="active-filters-bar" style="margin-bottom: 1rem; display: none;" data-active-filters>
            <style>
              .active-filters-bar {
                padding: 0;
              }
              .active-filters-bar.has-filters {
                display: block !important;
              }
              .active-filters-list {
                display: flex;
                flex-wrap: nowrap;
                gap: 0.5rem;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                scrollbar-width: none;
                -ms-overflow-style: none;
                padding-bottom: 0.5rem;
              }
              .active-filters-list::-webkit-scrollbar {
                display: none;
              }
              .filter-chip {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.5rem 1rem;
                background: #f3f4f6;
                border: none;
                border-radius: 16px;
                font-size: 1.2rem;
                color: #6B6467;
                flex-shrink: 0;
                white-space: nowrap;
              }
              .filter-chip:hover {
                background: #E6E1E2;
              }
              .filter-chip-remove {
                width: 1.4rem;
                height: 1.4rem;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                border-radius: 50%;
                background: #E6E1E2;
              }
              .filter-chip-remove:hover {
                background: #B23A3A;
                color: #fff;
              }
              .filter-chip-remove svg {
                width: 0.8rem;
                height: 0.8rem;
              }
            </style>
            <div class="active-filters-list" data-filters-list>
              <!-- Filter chips will be dynamically inserted here -->
            </div>
          </div>
          {% endif %}

          <!-- Desktop Inline Sort/Filter Bar - Sticky on scroll -->
          {% if is_collection_page %}
            {% render 'desktop-sort-filter-bar',
              has_filters: target_collection.filters.size > 0,
              title: target_collection.title,
              show_back_button: true,
              current_sort: target_collection.sort_by
            %}
          {% endif %}

          <!-- Desktop Filter Layout - Sidebar + Grid -->
          <div class="desktop-filter-layout">
            {% if is_collection_page %}
              {% render 'desktop-filter-sidebar', collection: target_collection %}
            {% endif %}

            <!-- ProductGridContainer wraps only the product grid that gets replaced by AJAX -->
            <div class="product-grid-container" id="ProductGridContainer">
          <div id="product-grid" data-id="{{ section.id }}" class="collection">
      {% if enable_infinite_scroll %}
        {%- comment -%} Infinite Scroll Mode {%- endcomment -%}
        {% paginate target_collection.products by products_to_show %}
          {% if target_collection.products_count == 0 %}
            <p class="text-center text-gray-500 py-12">
              No products found in this collection.
            </p>
          {% else %}
            <infinite-scroll
              data-next-page="{% if paginate.next %}{{ paginate.next.url }}{% endif %}"
              data-collection-handle="{{ target_collection.handle }}"
              data-threshold="1500">
              <ul class="grid cols-desktop-{{ columns_desktop }}"
                style="display: grid; grid-template-columns: repeat({{ columns_mobile }}, minmax(0, 1fr)); gap: {{ settings.modern_card_gap | default: 16 }}px;"
                role="list"
                data-infinite-scroll-container>
                {% for product in target_collection.products %}
                  <li>
                    {% render 'collection-product-card-modern',
                      product: product,
                      collection: target_collection,
                      title_color: settings.modern_card_title_color,
                      title_font_size: settings.modern_card_title_font_size,
                      title_font_weight: settings.modern_card_title_font_weight,
                      price_color: settings.modern_card_price_color,
                      price_font_size: settings.modern_card_price_font_size,
                      price_font_weight: settings.modern_card_price_font_weight,
                      original_price_color: settings.modern_card_original_price_color,
                      original_price_font_size: settings.modern_card_original_price_font_size,
                      discount_bg_color: settings.modern_card_discount_bg_color,
                      discount_text_color: settings.modern_card_discount_text_color,
                      inline_discount_color: settings.modern_card_inline_discount_color,
                      discount_font_size: settings.modern_card_discount_font_size,
                      enable_quick_buy: enable_quick_buy,
                      quick_buy_button_color: settings.modern_card_quick_buy_button_color,
                      quick_buy_button_text_color: settings.modern_card_quick_buy_button_text_color,
                      quick_buy_variant_font_size: settings.modern_card_quick_buy_variant_font_size
                    %}
                  </li>
                {% endfor %}
              </ul>

              {% if paginate.next %}
                <div class="mt-8 text-center">
                  <div data-infinite-scroll-spinner class="hidden">
                    {% render 'loading-spinner' %}
                  </div>
                  <button
                    type="button"
                    data-infinite-scroll-button
                    class="inline-block px-6 py-3 bg-black text-white font-medium rounded-lg hover:bg-gray-800 transition-colors">
                    Load More
                  </button>
                </div>
              {% endif %}
            </infinite-scroll>
          {% endif %}
        {% endpaginate %}
      {% elsif enable_pagination %}
        {% paginate target_collection.products by products_to_show %}
          {% if target_collection.products_count == 0 %}
            <p class="text-center text-gray-500 py-12">
              No products found in this collection.
            </p>
          {% else %}
            <ul class="grid cols-desktop-{{ columns_desktop }}"
              style="display: grid; grid-template-columns: repeat({{ columns_mobile }}, minmax(0, 1fr)); gap: {{ settings.modern_card_gap | default: 16 }}px;"
              role="list">
              {% for product in target_collection.products %}
                <li>
                  {% render 'collection-product-card-modern',
                    product: product,
                    collection: target_collection,
                    title_color: settings.modern_card_title_color,
                    title_font_size: settings.modern_card_title_font_size,
                    title_font_weight: settings.modern_card_title_font_weight,
                    price_color: settings.modern_card_price_color,
                    price_font_size: settings.modern_card_price_font_size,
                    price_font_weight: settings.modern_card_price_font_weight,
                    original_price_color: settings.modern_card_original_price_color,
                    original_price_font_size: settings.modern_card_original_price_font_size,
                    discount_bg_color: settings.modern_card_discount_bg_color,
                    discount_text_color: settings.modern_card_discount_text_color,
                    inline_discount_color: settings.modern_card_inline_discount_color,
                    discount_font_size: settings.modern_card_discount_font_size,
                    enable_quick_buy: enable_quick_buy,
                    quick_buy_button_color: settings.modern_card_quick_buy_button_color,
                    quick_buy_button_text_color: settings.modern_card_quick_buy_button_text_color,
                    quick_buy_variant_font_size: settings.modern_card_quick_buy_variant_font_size
                  %}
                </li>
              {% endfor %}
            </ul>

            {% if paginate.pages > 1 %}
              <div class="mt-8">
                {% render 'pagination', paginate: paginate %}
              </div>
            {% endif %}
          {% endif %}
        {% endpaginate %}
      {% else %}
        {%- comment -%} No pagination - show limited number of products {%- endcomment -%}
        {% if target_collection.products_count == 0 %}
          <p class="text-center text-gray-500 py-12">
            No products found in this collection.
          </p>
        {% else %}
          {% if use_carousel_markup %}<div class="cg-carousel{% unless is_carousel %} is-grid{% endunless %}">
            {% if show_layout_toggle %}
              <div class="cg-toggle" role="group" aria-label="Layout">
                <button type="button" class="cg-toggle-btn{% unless is_carousel %} is-active{% endunless %}" data-layout="grid" aria-label="Grid view">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z"/></svg>
                </button>
                <button type="button" class="cg-toggle-btn{% if is_carousel %} is-active{% endif %}" data-layout="carousel" aria-label="Carousel view">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M2 6h4v12H2V6zm6 0h8v12H8V6zm10 0h4v12h-4V6z"/></svg>
                </button>
              </div>
            {% endif %}
            <button type="button" class="cg-arrow cg-arrow--prev" aria-label="Previous">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>{% endif %}
          <ul class="{% if use_carousel_markup %}{% if is_carousel %}cg-track{% else %}cg-grid{% endif %}{% else %}grid cols-desktop-{{ columns_desktop }}{% endif %}"
            style="{% if use_carousel_markup %}--cg-cols: {{ columns_mobile }}; --cg-cols-desktop: {{ columns_desktop }}; --cg-gap: {{ card_gap }}px; gap: {{ card_gap }}px;{% else %}display: grid; grid-template-columns: repeat({{ columns_mobile }}, minmax(0, 1fr)); gap: {{ card_gap }}px;{% endif %}"
            role="list">
            {% for product in target_collection.products limit: products_to_show %}
              <li>
                {% render 'collection-product-card-modern',
                  product: product,
                  collection: target_collection,
                  title_color: settings.modern_card_title_color,
                  title_font_size: settings.modern_card_title_font_size,
                  title_font_weight: settings.modern_card_title_font_weight,
                  price_color: settings.modern_card_price_color,
                  price_font_size: settings.modern_card_price_font_size,
                  price_font_weight: settings.modern_card_price_font_weight,
                  original_price_color: settings.modern_card_original_price_color,
                  original_price_font_size: settings.modern_card_original_price_font_size,
                  discount_bg_color: settings.modern_card_discount_bg_color,
                  discount_text_color: settings.modern_card_discount_text_color,
                  inline_discount_color: settings.modern_card_inline_discount_color,
                  discount_font_size: settings.modern_card_discount_font_size,
                  enable_quick_buy: enable_quick_buy,
                  quick_buy_button_color: settings.modern_card_quick_buy_button_color,
                  quick_buy_button_text_color: settings.modern_card_quick_buy_button_text_color,
                  quick_buy_variant_font_size: settings.modern_card_quick_buy_variant_font_size
                %}
              </li>
            {% endfor %}
          </ul>
          {% if use_carousel_markup %}
            <button type="button" class="cg-arrow cg-arrow--next" aria-label="Next">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>{% endif %}

          {% if section.settings.show_view_all and target_collection.products_count > products_to_show %}
            <div class="text-center mt-8">
              <a href="{{ target_collection.url }}" class="inline-block px-6 py-3 bg-black text-white font-medium rounded-lg hover:bg-gray-800 transition-colors">
                View All {{ target_collection.title }}
              </a>
            </div>
          {% endif %}
        {% endif %}
      {% endif %}
          </div><!-- Close collection -->
        </div><!-- Close product-grid-container -->
          </div><!-- Close desktop-filter-layout -->
        </div><!-- Close product grid wrapper -->
      </div><!-- Close collection-with-filters -->
    {% else %}
      <p class="text-center text-gray-500 py-12">
        Please select a collection in the theme editor.
      </p>
    {% endif %}
  </div>
</div>

<style>
  /* Product grid container */
  .collection-with-filters {
    display: block;
  }

  .product-grid-container {
    width: 100%;
  }

  /* Desktop: Responsive column grid */
  @media (min-width: 768px) {
    .cols-desktop-2 { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    .cols-desktop-3 { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; }
    .cols-desktop-4 { grid-template-columns: repeat(4, minmax(0, 1fr)) !important; }
    .cols-desktop-5 { grid-template-columns: repeat(5, minmax(0, 1fr)) !important; }
    .cols-desktop-6 { grid-template-columns: repeat(6, minmax(0, 1fr)) !important; }
  }

  /* When filter sidebar is open, show 2 products per row */
  @media (min-width: 990px) {
    .desktop-filter-layout:has(.desktop-filter-sidebar.is-open) .grid[class*="cols-desktop"] {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }

  /* Infinite Scroll Styles */
  infinite-scroll {
    display: block;
  }

  infinite-scroll [data-infinite-scroll-spinner] {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem 0;
  }

  infinite-scroll [data-infinite-scroll-spinner].hidden {
    display: none;
  }

  infinite-scroll [data-infinite-scroll-button] {
    cursor: pointer;
  }

  infinite-scroll [data-infinite-scroll-button].hidden {
    display: none;
  }

  /* Product count line */
  .cg-count {
    font-size: 1.3rem;
    color: #6B6467;
    margin: -1rem 0 1.2rem;
  }

  /* Carousel mode */
  .cg-carousel { position: relative; }
  .cg-grid {
    display: grid;
    grid-template-columns: repeat(var(--cg-cols), minmax(0, 1fr));
    margin: 0;
    list-style: none;
  }
  .cg-carousel.is-grid .cg-arrow { display: none; }

  .cg-toggle {
    display: flex;
    justify-content: flex-end;
    gap: 4px;
    margin-bottom: 1rem;
  }
  .cg-toggle-btn {
    width: 32px; height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--elora-grey-line, #E6E1E2);
    border-radius: 6px;
    background: #fff;
    color: #6B6467;
    cursor: pointer;
    padding: 0;
  }
  .cg-toggle-btn.is-active {
    background: var(--elora-maroon, #111111);
    border-color: var(--elora-maroon, #111111);
    color: #fff;
  }

  .cg-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
    margin: 0;
    list-style: none;
  }
  .cg-track::-webkit-scrollbar { display: none; }
  .cg-track > li {
    /* one extra gap subtracted on mobile so the next card peeks */
    flex: 0 0 calc((100% - (var(--cg-gap) * var(--cg-cols))) / var(--cg-cols));
    scroll-snap-align: start;
  }
  .cg-track.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
  .cg-arrow {
    display: none;
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    width: 44px; height: 44px;
    border-radius: 50%;
    background: #FFFFFF;
    box-shadow: 0 4px 14px rgba(0,0,0,0.18);
    border: none;
    color: var(--elora-maroon, #111111);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
  }
  .cg-arrow--prev { left: -18px; }
  .cg-arrow--next { right: -18px; }

  @media (min-width: 768px) {
    .cg-grid { grid-template-columns: repeat(var(--cg-cols-desktop), minmax(0, 1fr)); }
    .cg-track { cursor: grab; }
    .cg-track > li {
      flex: 0 0 calc((100% - (var(--cg-gap) * (var(--cg-cols-desktop) - 1))) / var(--cg-cols-desktop));
    }
    .cg-arrow { display: flex; }
  }

  /* Loading state for AJAX filtering */
  .collection.loading {
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

</style>

{% if use_carousel_markup %}
<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    var wrap = section && section.querySelector('.cg-carousel');
    var track = wrap && wrap.querySelector('ul');
    if (!track) return;

    function step() {
      var item = track.querySelector('li');
      return item ? item.getBoundingClientRect().width + {{ card_gap }} : 300;
    }
    section.querySelector('.cg-arrow--prev').addEventListener('click', function () {
      if (track.scrollLeft <= 5) track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' });
      else track.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    section.querySelector('.cg-arrow--next').addEventListener('click', function () {
      if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 5) track.scrollTo({ left: 0, behavior: 'smooth' });
      else track.scrollBy({ left: step(), behavior: 'smooth' });
    });

    /* Click-and-drag on desktop; touch uses native scroll */
    var down = false, startX = 0, startScroll = 0, moved = false;
    track.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse') return;
      down = true; moved = false; startX = e.clientX; startScroll = track.scrollLeft;
      track.classList.add('is-dragging');
    });
    track.addEventListener('pointermove', function (e) {
      if (!down) return;
      var dx = e.clientX - startX;
      if (Math.abs(dx) > 3) moved = true;
      track.scrollLeft = startScroll - dx;
    });
    ['pointerup', 'pointerleave', 'pointercancel'].forEach(function (ev) {
      track.addEventListener(ev, function () { down = false; track.classList.remove('is-dragging'); });
    });
    track.addEventListener('click', function (e) { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);

    /* Grid / carousel toggle */
    wrap.querySelectorAll('.cg-toggle-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var carousel = btn.dataset.layout === 'carousel';
        wrap.classList.toggle('is-grid', !carousel);
        track.classList.toggle('cg-track', carousel);
        track.classList.toggle('cg-grid', !carousel);
        if (!carousel) track.scrollLeft = 0;
        wrap.querySelectorAll('.cg-toggle-btn').forEach(function (b) { b.classList.toggle('is-active', b === btn); });
        try { localStorage.setItem('cg-layout-{{ section.id }}', btn.dataset.layout); } catch (e) {}
      });
    });
    try {
      var saved = localStorage.getItem('cg-layout-{{ section.id }}');
      if (saved) {
        var savedBtn = wrap.querySelector('.cg-toggle-btn[data-layout="' + saved + '"]');
        if (savedBtn && !savedBtn.classList.contains('is-active')) savedBtn.click();
      }
    } catch (e) {}
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Collection Grid",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Select a collection to display. Leave empty to use the current collection on collection pages."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel (swipe + arrows)" }
      ],
      "default": "grid",
      "info": "Carousel shows one row of products with arrows and swipe. Pagination and infinite scroll are ignored in this mode."
    },
    {
      "type": "checkbox",
      "id": "show_layout_toggle",
      "label": "Show grid / carousel toggle button",
      "default": false,
      "info": "Lets shoppers switch views. Starts in the layout chosen above; the choice is remembered. Pagination and infinite scroll are ignored when this is on."
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "label": "Show heading",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Custom heading text",
      "info": "Leave empty to use collection title. Add custom text to override."
    },
    {
      "type": "header",
      "content": "Heading Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading font size",
      "default": 32
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading font weight",
      "options": [
