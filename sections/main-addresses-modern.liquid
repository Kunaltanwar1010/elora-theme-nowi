{{ 'tailwind.css' | asset_url | stylesheet_tag }}
{{ 'account-modern.css' | asset_url | stylesheet_tag }}

<script src="{{ 'customer.js' | asset_url }}" defer></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- paginate customer.addresses by 10 -%}
  <div class="addresses-modern section-{{ section.id }}-padding" data-customer-addresses>
    <div class="page-width px-4 lg:px-6">
      <!-- Desktop: Sidebar + Content Layout -->
      <div class="account-page-layout">

        <!-- Sidebar (Desktop only) -->
        {% render 'account-sidebar', active_page: 'addresses' %}

        <!-- Main Content -->
        <div class="flex-1 min-w-0">
          <!-- Header -->
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <!-- Back button - mobile only -->
              <a
                href="{{ routes.account_url }}"
                class="mobile-back-btn flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
              </a>
              <h3 class="text-[16px] md:text-[18px] font-semibold text-gray-900">{{ 'customer.addresses.title' | t }}</h3>
            </div>
            <button
              type="button"
              id="AddAddressBtn"
              class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-gray-900 text-[13px] md:text-[14px] font-medium hover:brightness-95 transition-all"
              style="background-color: #FFBF00;"
              aria-expanded="false"
              aria-controls="AddAddressForm"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Add New
            </button>
          </div>

          <!-- Add New Address Form (Hidden) -->
          <div id="AddAddressForm" class="hidden mb-4">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4">
              <div class="flex items-center justify-between mb-3">
                <h2 class="text-[15px] md:text-[16px] font-semibold text-gray-900">New Address</h2>
                <button
                  type="button"
                  class="w-6 h-6 flex items-center justify-center rounded-full bg-gray-100 text-gray-500 hover:bg-gray-200 transition-colors close-add-form-btn"
                >
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
              {%- form 'customer_address', customer.new_address, aria-labelledBy: 'AddressNewHeading' -%}
                {% render 'account-address-form', form: form, form_id: 'new', is_new: true %}
              {%- endform -%}
            </div>
          </div>

          <!-- Addresses List -->
          {%- if customer.addresses.size > 0 -%}
            <!-- Addresses List -->
            <div class="space-y-4">
              {%- for address in customer.addresses -%}
                {%- assign is_default_address = false -%}
                {%- if customer.default_address and address.id == customer.default_address.id -%}
                  {%- assign is_default_address = true -%}
                {%- endif -%}
                {%
                  render 'account-address-card',
                  address: address,
                  is_default: is_default_address,
                  index: forloop.index
                %}
              {%- endfor -%}
            </div>

            <!-- Pagination -->
            {%- if paginate.pages > 1 -%}
              <nav class="mt-10 flex justify-center" aria-label="{{ 'general.pagination.label' | t }}">
                <ul class="flex items-center gap-2" role="list">
                  {%- if paginate.previous -%}
                    <li>
                      <a
                        href="{{ paginate.previous.url }}"
                        class="w-10 h-10 md:w-12 md:h-12 flex items-center justify-center rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors"
                        aria-label="{{ 'general.pagination.previous' | t }}"
                      >
                        <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                      </a>
                    </li>
                  {%- endif -%}

                  {%- for part in paginate.parts -%}
                    <li>
                      {%- if part.is_link -%}
                        <a
                          href="{{ part.url }}"
                          class="w-10 h-10 md:w-12 md:h-12 flex items-center justify-center rounded-full text-[14px] md:text-[15px] font-medium text-gray-700 hover:bg-gray-100 transition-colors"
                          aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                        >
                          {{ part.title }}
                        </a>
                      {%- else -%}
                        {%- if part.title == paginate.current_page -%}
                          <span
                            class="w-10 h-10 md:w-12 md:h-12 flex items-center justify-center rounded-full text-[14px] md:text-[15px] font-medium bg-gray-900 text-white"
                            aria-current="page"
                            aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                          >
                            {{ part.title }}
                          </span>
                        {%- else -%}
                          <span class="w-10 h-10 md:w-12 md:h-12 flex items-center justify-center text-[14px] md:text-[15px] text-gray-400">
                            {{ part.title }}
                          </span>
                        {%- endif -%}
                      {%- endif -%}
                    </li>
                  {%- endfor -%}

                  {%- if paginate.next -%}
                    <li>
                      <a
                        href="{{ paginate.next.url }}"
                        class="w-10 h-10 md:w-12 md:h-12 flex items-center justify-center rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors"
                        aria-label="{{ 'general.pagination.next' | t }}"
                      >
                        <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </a>
                    </li>
                  {%- endif -%}
                </ul>
              </nav>
            {%- endif -%}
          {%- else -%}
            <!-- Empty State -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 md:p-10 text-center">
              <div class="w-14 h-14 md:w-16 md:h-16 mx-auto mb-4 md:mb-5 rounded-full bg-gray-100 flex items-center justify-center">
                <svg class="w-7 h-7 md:w-8 md:h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <h3 class="text-[16px] md:text-[18px] font-semibold text-gray-900 mb-2">No addresses yet</h3>
              <p class="text-[14px] md:text-[15px] text-gray-500 mb-6">Add your first address to make checkout faster.</p>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endpaginate -%}

<!-- Delete Confirmation Modal -->
<div
  id="DeleteConfirmModal"
  style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9999; background-color: rgba(0, 0, 0, 0.5);"
  data-modal-backdrop
>
  <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; padding: 24px;">
    <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full p-6">
      <div class="text-center">
        <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-red-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </div>
        <h3 class="text-[16px] md:text-[18px] font-semibold text-gray-900 mb-2">Delete Address?</h3>
        <p class="text-[14px] md:text-[15px] text-gray-500 mb-5" id="DeleteConfirmMessage">
          Are you sure you want to delete this address?
        </p>
        <div class="flex gap-3 justify-center">
          <button
            type="button"
            class="px-5 md:px-6 py-2.5 rounded-full bg-gray-100 text-gray-700 text-[14px] md:text-[15px] font-medium hover:bg-gray-200 transition-colors"
            data-modal-cancel
          >
            Cancel
          </button>
          <button
            type="button"
            id="ConfirmDeleteBtn"
            class="inline-flex items-center justify-center gap-1.5 px-5 md:px-6 py-2.5 rounded-full bg-red-600 text-white text-[14px] md:text-[15px] font-medium hover:bg-red-700 transition-colors"
          >
            Delete
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'account-modern.js' | asset_url }}" defer></script>

<script>
  // Initialize CustomerAddresses for country/province handling
  window.addEventListener('load', () => {
    if (typeof CustomerAddresses !== 'undefined') {
      new CustomerAddresses();
    }
  });
</script>

{% schema %}
{
  "name": "Addresses Page (Modern)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
