{%- liquid
  # For "adapt to image": use the first slide's image dimensions to set the
  # carousel aspect ratio, so the image shows uncropped instead of being
  # cover-cropped to a fixed vh height.
  assign first_desktop = null
  assign first_mobile = null
  for block in section.blocks
    if first_desktop == null and block.settings.desktop_image != blank
      assign first_desktop = block.settings.desktop_image
    endif
    if first_mobile == null and block.settings.mobile_image != blank
      assign first_mobile = block.settings.mobile_image
    endif
  endfor
  if first_mobile == null
    assign first_mobile = first_desktop
  endif
-%}
<div class="hero-carousel-wrapper" id="hero-carousel-{{ section.id }}">
  <div class="swiper hero-swiper hero-swiper-{{ section.id }}">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide">
          {% if block.settings.cta_link != blank %}
            <a href="{{ block.settings.cta_link }}" class="hero-slide hero-slide--link" style="background-color: {{ block.settings.background_color }};">
          {% else %}
            <div class="hero-slide" style="background-color: {{ block.settings.background_color }};">
          {% endif %}
            {% if block.settings.media_type == 'video' and block.settings.video != blank %}
              <video
                class="hero-video"
                autoplay
                muted
                loop
                playsinline
                disablepictureinpicture
                webkit-playsinline
                {% if block.settings.video.preview_image %}
                  poster="{{ block.settings.video.preview_image | image_url: width: 2000 }}"
                {% endif %}
              >
                {%- for source in block.settings.video.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              </video>
            {% else %}
              <img
                srcset="
                  {%- if block.settings.desktop_image.width >= 375 -%}{{ block.settings.desktop_image | image_url: width: 375 }} 375w,{%- endif -%}
                  {%- if block.settings.desktop_image.width >= 750 -%}{{ block.settings.desktop_image | image_url: width: 750 }} 750w,{%- endif -%}
                  {%- if block.settings.desktop_image.width >= 1200 -%}{{ block.settings.desktop_image | image_url: width: 1200 }} 1200w,{%- endif -%}
                  {%- if block.settings.desktop_image.width >= 1800 -%}{{ block.settings.desktop_image | image_url: width: 1800 }} 1800w,{%- endif -%}
                  {%- if block.settings.desktop_image.width >= 2400 -%}{{ block.settings.desktop_image | image_url: width: 2400 }} 2400w{%- endif -%}
                "
                src="{{ block.settings.desktop_image | image_url: width: 1200 }}"
                sizes="100vw"
                alt="{{ block.settings.desktop_image.alt | escape }}"
                class="hero-image hero-image--desktop"
                loading="eager"
                fetchpriority="high"
                width="{{ block.settings.desktop_image.width }}"
                height="{{ block.settings.desktop_image.height }}"
              >
              {%- if block.settings.mobile_image -%}
                <img
                  srcset="
                    {%- if block.settings.mobile_image.width >= 375 -%}{{ block.settings.mobile_image | image_url: width: 375 }} 375w,{%- endif -%}
                    {%- if block.settings.mobile_image.width >= 750 -%}{{ block.settings.mobile_image | image_url: width: 750 }} 750w,{%- endif -%}
                    {%- if block.settings.mobile_image.width >= 1200 -%}{{ block.settings.mobile_image | image_url: width: 1200 }} 1200w{%- endif -%}
                  "
                  src="{{ block.settings.mobile_image | image_url: width: 750 }}"
                  sizes="100vw"
                  alt="{{ block.settings.mobile_image.alt | escape }}"
                  class="hero-image hero-image--mobile"
                  loading="eager"
                  fetchpriority="high"
                  width="{{ block.settings.mobile_image.width }}"
                  height="{{ block.settings.mobile_image.height }}"
                >
              {%- endif -%}
            {% endif %}
          {% if block.settings.cta_link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <!-- Navigation Arrows -->
    {% if section.settings.show_arrows %}
      <div class="swiper-button-prev hero-button-prev" aria-label="Previous slide">←</div>
      <div class="swiper-button-next hero-button-next" aria-label="Next slide">→</div>
    {% endif %}

    <!-- Pagination Dots -->
    {% if section.settings.show_dots %}
      <div class="swiper-pagination hero-pagination" role="tablist"></div>
    {% endif %}
  </div>
</div>

{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'component-hero-carousel.css' | asset_url | stylesheet_tag }}

<style>
  #hero-carousel-{{ section.id }} {
    width: 100%;
    {%- if section.settings.adapt_to_image and first_desktop -%}
      aspect-ratio: {{ first_desktop.aspect_ratio }};
      height: auto;
    {%- else -%}
      height: {{ section.settings.hero_height_desktop }}vh;
    {%- endif -%}
  }

  #hero-carousel-{{ section.id }} .hero-swiper,
  #hero-carousel-{{ section.id }} .swiper-slide,
  #hero-carousel-{{ section.id }} .hero-slide {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 749px) {
    #hero-carousel-{{ section.id }} {
      {%- if section.settings.adapt_to_image and first_mobile -%}
        aspect-ratio: {{ first_mobile.aspect_ratio }};
        height: auto;
      {%- else -%}
        height: {{ section.settings.hero_height_mobile }}vh;
      {%- endif -%}
    }
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

<script>
  (function() {
    const sectionId = '{{ section.id }}';

    function initHeroCarousel() {
      if (typeof Swiper === 'undefined') {
        setTimeout(initHeroCarousel, 100);
        return;
      }

      const container = document.getElementById('hero-carousel-' + sectionId);
      if (!container) return;

      const swiperEl = container.querySelector('.hero-swiper');
      if (!swiperEl) return;

      const swiper = new Swiper(swiperEl, {
        // Slide configuration
        loop: {{ section.settings.loop | default: true }},
        preventClicks: false,
        preventClicksPropagation: false,
        slidesPerView: 1,
        spaceBetween: 0,
        effect: '{{ section.settings.transition_effect | default: "fade" }}',
        speed: {{ section.settings.transition_speed | default: 800 }},

        // Touch/swipe sensitivity
        touchRatio: 1.5,
        threshold: 10,
        longSwipesRatio: 0.3,
        longSwipesMs: 200,
        shortSwipes: true,
        resistanceRatio: 0.5,

        // Autoplay
        autoplay: {
          delay: {{ section.settings.autoplay_delay | default: 5000 }},
          disableOnInteraction: false,
        },

        // Navigation
        pagination: {
          el: container.querySelector('.hero-pagination'),
          clickable: true,
          dynamicBullets: false,
        },
        navigation: {
          nextEl: container.querySelector('.hero-button-next'),
          prevEl: container.querySelector('.hero-button-prev'),
        },

        // Event handlers
        on: {
          slideChange: function() {
            const videos = swiperEl.querySelectorAll('.hero-video');
            videos.forEach(function(video) {
              video.pause();
            });

            const activeSlide = this.slides[this.activeIndex];
            if (activeSlide) {
              const video = activeSlide.querySelector('.hero-video');
              if (video) {
                video.currentTime = 0;
                video.play().catch(function() {});
              }
            }
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroCarousel);
    } else {
      initHeroCarousel();
    }
  })();
</script>

{% schema %}
{
  "name": "Hero Carousel",
  "settings": [
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Enable Loop",
      "default": true,
      "info": "Carousel will loop infinitely"
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "label": "Autoplay Delay",
      "default": 5000
    },
    {
      "type": "select",
      "id": "transition_effect",
      "label": "Transition Effect",
      "options": [
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "slide",
          "label": "Slide"
        },
        {
          "value": "cube",
          "label": "Cube"
        },
        {
          "value": "coverflow",
          "label": "Coverflow"
        },
        {
          "value": "flip",
          "label": "Flip"
        }
      ],
      "default": "fade"
    },
    {
      "type": "range",
      "id": "transition_speed",
      "min": 300,
      "max": 2000,
      "step": 100,
      "unit": "ms",
      "label": "Transition Speed",
      "default": 800
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Pagination Dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "adapt_to_image",
      "label": "Adapt height to image",
      "default": true,
      "info": "Sizes the carousel to the first slide's image aspect ratio (no cropping). Turn off to use the fixed heights below."
    },
    {
      "type": "range",
      "id": "hero_height_desktop",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Height on desktop (when adapt is off)",
      "default": 70
    },
    {
      "type": "range",
      "id": "hero_height_mobile",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "vh",
      "label": "Height on mobile (when adapt is off)",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Carousel Slide",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media Type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop Image",
          "info": "Image for desktop view"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image (optional)",
          "info": "If not set, desktop image will be used on mobile too"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video File",
          "info": "Used when Media Type is set to Video. Shopify auto-generates thumbnail."
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Slide Link URL"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "default": "#FEFAFA"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Carousel",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "background_color": "#FEFAFA"
          }
        },
        {
          "type": "slide",
          "settings": {
            "background_color": "#FEFAFA"
          }
        }
      ]
    }
  ]
}
{% endschema %}
