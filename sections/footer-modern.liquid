{% comment %}
  Modern Ecommerce Footer - Inspired by Nike, Shopify & Etsy
  Features:
  - Full color customization in settings
  - Mobile-optimized with collapsible sections
  - Logo upload support
  - Policy links prominently displayed
  - Newsletter subscription
  - Social media integration
  - Direct px units throughout
{% endcomment %}

<style>
  .footer-branded-{{ section.id }} {
    font-family: inherit;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-bottom: 50px;
  }

  .footer-branded-{{ section.id }} h3 {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: 700;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .footer-branded-{{ section.id }} p {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.body_font_size }}px;
  }

  .footer-branded-{{ section.id }} .footer-link {
    display: block;
    text-decoration: none;
    padding: 8px 0;
    line-height: 1.5;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.link_font_size }}px;
  }

  .footer-branded-{{ section.id }} .footer-link:hover {
    color: {{ section.settings.accent_color }};
  }

  /* Newsletter */
  .footer-branded-{{ section.id }} .newsletter-form {
    margin-top: 16px;
  }

  .footer-branded-{{ section.id }} .newsletter-input {
    width: 100%;
    padding: 14px 16px;
    border-radius: 4px;
    border: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.2 }};
    background: transparent;
    outline: none;
    margin-bottom: 12px;
  }

  .footer-branded-{{ section.id }} .newsletter-input:focus {
    border-color: {{ section.settings.accent_color }};
  }

  .footer-branded-{{ section.id }} .newsletter-btn {
    width: 100%;
    padding: 14px 24px;
    border-radius: 4px;
    background: {{ section.settings.accent_color }};
    color: {{ section.settings.bg_color }};
    font-weight: 700;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .footer-branded-{{ section.id }} .newsletter-btn:hover {
    opacity: 0.9;
  }

  /* Accordion (all screen sizes) */
  .footer-branded-{{ section.id }} .footer-column h3 {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    padding: 12px 0;
    margin-bottom: 0;
  }

  .footer-branded-{{ section.id }} .footer-column h3::after {
    content: '+';
    font-size: 24px;
    color: {{ section.settings.accent_color }};
    font-weight: 400;
  }

  .footer-branded-{{ section.id }} .footer-column.is-open h3::after {
    content: '−';
  }

  .footer-branded-{{ section.id }} .footer-links {
    max-height: 0;
    overflow: hidden;
  }

  .footer-branded-{{ section.id }} .footer-column.is-open .footer-links {
    max-height: 1000px;
    padding-top: 12px;
    padding-bottom: 12px;
  }

  /* Social icons — one centered row, same on mobile and desktop */
  .footer-branded-{{ section.id }} .footer-social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: {{ section.settings.social_icon_gap }}px;
  }

  .footer-branded-{{ section.id }} .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.text_color }};
    {%- if section.settings.social_icon_style == 'circle' %}
    width: {{ section.settings.social_icon_size | plus: 20 }}px;
    height: {{ section.settings.social_icon_size | plus: 20 }}px;
    background: {{ section.settings.accent_color }};
    color: {{ section.settings.bg_color }};
    border-radius: 50%;
    {%- endif %}
  }

  .footer-branded-{{ section.id }} .social-icon svg {
    width: {{ section.settings.social_icon_size }}px;
    height: {{ section.settings.social_icon_size }}px;
  }

  .footer-branded-{{ section.id }} .social-icon:hover {
    opacity: 0.8;
  }

  /* Layout Grid (mobile style on all screens) */
  .footer-branded-{{ section.id }} .footer-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
    padding: 26px 16px;
    max-width: var(--page-width);
    margin: 0 auto;
  }

  /* Bottom Bar - vertical layout on all screens */
  .footer-branded-{{ section.id }} .footer-bottom-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.15 }};
    grid-column: 1 / -1;
  }

  .footer-branded-{{ section.id }} .copyright {
    font-size: 14px;
    color: {{ section.settings.text_color }};
    text-align: center;
  }

  /* Policy links - always hidden in bottom bar (shown in Important Links instead) */
  .footer-branded-{{ section.id }} .policy-links {
    display: none;
  }

  /* Policy links in Important Links section - always visible */
  .footer-branded-{{ section.id }} .mobile-policy-links {
    display: block;
    padding-top: 0;
    margin-top: 0;
  }

  .footer-branded-{{ section.id }} .policy-link {
    font-size: 14px;
    color: {{ section.settings.text_color }};
    text-decoration: none;
  }

  .footer-branded-{{ section.id }} .policy-link:hover {
    color: {{ section.settings.accent_color }};
  }

</style>

<footer class="footer-branded-{{ section.id }}">
  <div class="footer-grid">
    <!-- Brand Column -->
    <div class="footer-column">
      {%- if section.settings.logo != blank -%}
        <a href="{{ routes.root_url }}">
          <img
            src="{{ section.settings.logo | image_url: width: 360 }}"
            alt="{{ shop.name }}"
            loading="lazy"
            style="max-width: {{ section.settings.logo_width }}px; height: auto; margin-bottom: 20px;"
            class="footer-logo"
          >
        </a>
      {%- else -%}
        <a href="{{ routes.root_url }}">
          <h2 style="font-weight: 800; margin-bottom: 20px;">
            {{ shop.name }}
          </h2>
        </a>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p style="line-height: 1.6; margin-bottom: 24px;">
          {{ section.settings.description }}
        </p>
      {%- endif -%}

    </div>

    <!-- Shop Links -->
    <div class="footer-column" onclick="this.classList.toggle('is-open')">
      <h3>Shop</h3>
      <div class="footer-links">
        {%- if section.settings.menu_shop != blank -%}
          {%- for link in linklists[section.settings.menu_shop].links -%}
            <a href="{{ link.url }}" class="footer-link">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <!-- Important Links -->
    <div class="footer-column" onclick="this.classList.toggle('is-open')">
      <h3>Important Links</h3>
      <div class="footer-links">
        {%- if section.settings.menu_important != blank -%}
          {%- for link in linklists[section.settings.menu_important].links -%}
            <a href="{{ link.url }}" class="footer-link">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}

        {%- if section.settings.show_policies -%}
          <div class="mobile-policy-links">
            {%- if shop.privacy_policy -%}
              <a href="{{ shop.privacy_policy.url }}" class="footer-link">Privacy Policy</a>
            {%- endif -%}
            {%- if shop.terms_of_service -%}
              <a href="{{ shop.terms_of_service.url }}" class="footer-link">Terms of Service</a>
            {%- endif -%}
            {%- if shop.refund_policy -%}
              <a href="{{ shop.refund_policy.url }}" class="footer-link">Refund Policy</a>
            {%- endif -%}
            {%- if shop.shipping_policy -%}
              <a href="{{ shop.shipping_policy.url }}" class="footer-link">Shipping Policy</a>
            {%- endif -%}
            {%- if shop.subscription_policy -%}
              <a href="{{ shop.subscription_policy.url }}" class="footer-link">Subscription Policy</a>
            {%- endif -%}
            <a href="{{ routes.root_url }}policies/contact-information" class="footer-link">Contact Us</a>
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- Newsletter -->
    {%- if section.settings.show_newsletter -%}
      <div class="footer-column" onclick="event.stopPropagation();">
        <h3 style="cursor: default;">{{ section.settings.newsletter_heading }}</h3>
        <div class="footer-links" style="max-height: none; padding: 0;">
          <p style="margin-bottom: 16px;">
            {{ section.settings.newsletter_text }}
          </p>
          {%- form 'customer', class: 'newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input
              type="email"
              name="contact[email]"
              class="newsletter-input"
              placeholder="Enter your email"
              required
              autocomplete="email"
            >
            <button type="submit" class="newsletter-btn">Subscribe</button>
          {%- endform -%}
        </div>
      </div>
    {%- endif -%}

    <!-- Bottom Bar -->
    <div class="footer-bottom-content">
      {%- if section.settings.show_social -%}
        {% render 'footer-social-icons' %}
      {%- endif -%}

      {%- if section.settings.show_policies -%}
        <div class="policy-links">
          {%- if shop.privacy_policy -%}
            <a href="{{ shop.privacy_policy.url }}" class="policy-link">Privacy Policy</a>
          {%- endif -%}
          {%- if shop.terms_of_service -%}
            <a href="{{ shop.terms_of_service.url }}" class="policy-link">Terms of Service</a>
          {%- endif -%}
          {%- if shop.refund_policy -%}
            <a href="{{ shop.refund_policy.url }}" class="policy-link">Refund Policy</a>
          {%- endif -%}
          {%- if shop.shipping_policy -%}
            <a href="{{ shop.shipping_policy.url }}" class="policy-link">Shipping Policy</a>
          {%- endif -%}
          {%- if shop.subscription_policy -%}
            <a href="{{ shop.subscription_policy.url }}" class="policy-link">Subscription Policy</a>
          {%- endif -%}
          <a href="{{ routes.root_url }}policies/contact-information" class="policy-link">Contact Us</a>
        </div>
      {%- endif -%}

      <p class="copyright">
        © {{ 'now' | date: '%Y' }}
        {{ shop.name }}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer Branded",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Buttons, Hover)",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo",
      "info": "Recommended: 180px x 50px PNG with transparent background"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width (px)",
      "min": 80,
      "max": 300,
      "step": 10,
      "default": 180,
      "unit": "px"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Brand Description",
      "default": "Quality products for modern living. Shop with confidence."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading Font Size (px)",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body Font Size (px)",
      "min": 12,
      "max": 18,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "link_font_size",
      "label": "Link Font Size (px)",
      "min": 12,
      "max": 18,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Navigation Menus"
    },
    {
      "type": "link_list",
      "id": "menu_shop",
      "label": "Shop Menu",
      "info": "Create menu in Navigation settings"
    },
    {
      "type": "link_list",
      "id": "menu_important",
      "label": "Important Links Menu",
      "info": "Add links like Contact, About, FAQs, etc."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Newsletter Signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Stay Updated"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter Description",
      "default": "Get the latest updates on new products and exclusive offers."
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Icons",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Leave a URL blank to hide that icon. Anything left empty falls back to Theme settings > Social media."
    },
    {
      "type": "select",
      "id": "social_icon_style",
      "label": "Icon Style",
      "options": [
        { "value": "plain", "label": "Plain icons" },
        { "value": "circle", "label": "Icons in a circle" }
      ],
      "default": "plain"
    },
    {
      "type": "range",
      "id": "social_icon_size",
      "label": "Icon Size",
      "min": 14,
      "max": 36,
      "step": 2,
      "default": 22,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "social_icon_gap",
      "label": "Space Between Icons",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "Twitter / X URL"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "social_snapchat",
      "label": "Snapchat URL"
    },
    {
      "type": "header",
      "content": "Footer Bottom"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show Policy Links",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Footer Branded"
    }
  ]
}
{% endschema %}
