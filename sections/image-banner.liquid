{%- comment -%}
  Full-width lifestyle banner (collection promo). Desktop + mobile image,
  overlay heading / subline / CTA, schema-controlled height (vh), text position
  (9-point grid) and overlay opacity. Maroon-themed. Reusable per collection.
{%- endcomment -%}

{%- liquid
  assign pos = section.settings.text_position
  assign align = 'center'
  if pos contains 'left'
    assign align = 'left'
  elsif pos contains 'right'
    assign align = 'right'
  endif
  assign justify = 'center'
  if pos contains 'top'
    assign justify = 'flex-start'
  elsif pos contains 'bottom'
    assign justify = 'flex-end'
  endif
  assign items = 'center'
  if pos contains 'left'
    assign items = 'flex-start'
  elsif pos contains 'right'
    assign items = 'flex-end'
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .ib {
    position: relative;
    width: 100%;
    height: {{ section.settings.height_mobile | default: 60 }}vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: {{ justify }};
    align-items: {{ items }};
    text-align: {{ align }};
  }
  #shopify-section-{{ section.id }} .ib__media { position: absolute; inset: 0; z-index: 0; }
  #shopify-section-{{ section.id }} .ib__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .ib__scrim {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(to top, rgba(90,15,24,{{ section.settings.overlay_opacity | default: 35 | divided_by: 100.0 }}), rgba(17,17,17,{{ section.settings.overlay_opacity | default: 35 | divided_by: 200.0 }}));
  }
  #shopify-section-{{ section.id }} .ib__content {
    position: relative; z-index: 2;
    padding: clamp(20px, 5vw, 64px);
    max-width: 640px;
    color: {{ section.settings.text_color | default: '#FFFFFF' }};
  }
  #shopify-section-{{ section.id }} .ib__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(26px, 5vw, 44px);
    font-weight: 700; line-height: 1.1; margin: 0 0 10px;
  }
  #shopify-section-{{ section.id }} .ib__sub { font-size: clamp(14px, 2vw, 18px); line-height: 1.4; margin: 0 0 20px; opacity: 0.95; }
  #shopify-section-{{ section.id }} .ib__cta {
    display: inline-block;
    background: var(--elora-maroon, #7A1520);
    color: #FFFFFF;
    padding: 12px 32px;
    border-radius: 40px;
    font-weight: 600; font-size: 14px; text-decoration: none;
    transition: background 0.2s ease;
  }
  #shopify-section-{{ section.id }} .ib__cta:hover { background: var(--elora-maroon-deep, #5A0F18); }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .ib { height: {{ section.settings.height_desktop | default: 70 }}vh; }
  }
</style>

<div class="ib">
  <div class="ib__media">
    {%- if section.settings.image_desktop != blank -%}
      <img
        src="{{ section.settings.image_desktop | image_url: width: 2000 }}"
        srcset="{{ section.settings.image_desktop | image_url: width: 750 }} 750w, {{ section.settings.image_desktop | image_url: width: 1500 }} 1500w, {{ section.settings.image_desktop | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ section.settings.heading | escape }}"
        width="{{ section.settings.image_desktop.width }}" height="{{ section.settings.image_desktop.height }}"
        loading="lazy"
        class="small-hide medium-hide"
      >
    {%- endif -%}
    {%- assign mobile_img = section.settings.image_mobile | default: section.settings.image_desktop -%}
    {%- if mobile_img != blank -%}
      <img
        src="{{ mobile_img | image_url: width: 900 }}"
        alt="{{ section.settings.heading | escape }}"
        width="{{ mobile_img.width }}" height="{{ mobile_img.height }}"
        loading="lazy"
        class="medium-up-hide{% if section.settings.image_desktop != blank %} large-up-hide{% endif %}"
      >
    {%- endif -%}
    {%- if section.settings.image_desktop == blank and mobile_img == blank -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'ib__placeholder' }}
    {%- endif -%}
  </div>
  <div class="ib__scrim"></div>
  <div class="ib__content">
    {%- if section.settings.heading != blank -%}<h2 class="ib__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="ib__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    {%- if section.settings.cta_text != blank and section.settings.cta_link != blank -%}
      <a href="{{ section.settings.cta_link }}" class="ib__cta">{{ section.settings.cta_text }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Image Banner",
  "tag": "section",
  "class": "section-image-banner",
  "settings": [
    { "type": "image_picker", "id": "image_desktop", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Falls back to desktop image." },
    { "type": "range", "id": "height_desktop", "label": "Desktop height", "min": 30, "max": 100, "step": 5, "unit": "vh", "default": 70 },
    { "type": "range", "id": "height_mobile", "label": "Mobile height", "min": 30, "max": 100, "step": 5, "unit": "vh", "default": 60 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the collection" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Shop now" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    {
      "type": "select", "id": "text_position", "label": "Text position", "default": "middle-center",
      "options": [
        { "value": "top-left", "label": "Top left" }, { "value": "top-center", "label": "Top center" }, { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" }, { "value": "middle-center", "label": "Middle center" }, { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-center", "label": "Bottom center" }, { "value": "bottom-right", "label": "Bottom right" }
      ]
    },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#FFFFFF" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 }
  ],
  "presets": [ { "name": "Image Banner" } ]
}
{% endschema %}
