{% comment %}
  Watch & Buy — shoppable vertical video carousel.
  Each block: one 9:16 reel + one product. The product card is pinned
  under the video with a quick-add button (reuses quick-buy-modal so
  size selection still happens before add-to-cart).

  Videos autoplay muted when in view (IntersectionObserver pauses
  off-screen reels), tap the video to toggle sound.
{% endcomment %}

{{ 'component-quick-buy.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-buy.js' | asset_url }}" defer="defer"></script>

<style>
  #shopify-section-{{ section.id }} .wnb {
    padding: {{ section.settings.padding_y }}px 0;
    background: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .wnb__heading {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0 0 2rem;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .wnb__track {
    display: flex;
    gap: 1.2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0 0 0.5rem;
  }
  #shopify-section-{{ section.id }} .wnb__track::-webkit-scrollbar { display: none; }
  @media (min-width: 750px) { #shopify-section-{{ section.id }} .wnb__track { cursor: grab; } }
  #shopify-section-{{ section.id }} .wnb__track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
    user-select: none;
  }
  #shopify-section-{{ section.id }} .wnb__wrap {
    position: relative;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  #shopify-section-{{ section.id }} .wnb__arrow {
    display: none;
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #FFFFFF;
    box-shadow: 0 4px 14px rgba(0,0,0,0.18);
    border: none;
    color: var(--elora-maroon, #111111);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
  }
  #shopify-section-{{ section.id }} .wnb__arrow:hover { background: #FEFAFA; }
  #shopify-section-{{ section.id }} .wnb__arrow--prev { left: 0.75rem; }
  #shopify-section-{{ section.id }} .wnb__arrow--next { right: 0.75rem; }
  #shopify-section-{{ section.id }} .wnb__dots { display: flex; justify-content: center; gap: 8px; margin-top: 1.6rem; }
  #shopify-section-{{ section.id }} .wnb__dot { width: 8px; height: 8px; border-radius: 50%; border: none; padding: 0; background: var(--elora-grey-line, #E6E1E2); cursor: pointer; transition: background 0.2s, width 0.2s; }
  #shopify-section-{{ section.id }} .wnb__dot.is-active { background: var(--elora-maroon, #111111); width: 20px; border-radius: 4px; }
  #shopify-section-{{ section.id }} .wnb__item {
    flex: 0 0 62%;
    max-width: 260px;
    scroll-snap-align: start;
  }
  #shopify-section-{{ section.id }} .wnb__video-wrap {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 14px;
    overflow: hidden;
    background: #111111;
  }
  #shopify-section-{{ section.id }} .wnb__video-wrap video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .wnb__sound {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: none;
    background: rgba(0,0,0,0.55);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .wnb__card {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    background: #fff;
    border-radius: 12px;
    padding: 0.8rem;
    margin-top: -2.4rem;
    position: relative;
    margin-left: 0.8rem;
    margin-right: 0.8rem;
    box-shadow: 0 4px 14px rgba(0,0,0,0.10);
  }
  #shopify-section-{{ section.id }} .wnb__card-img {
    width: 4.4rem;
    height: 5.5rem;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .wnb__card-info { min-width: 0; flex: 1; }
  #shopify-section-{{ section.id }} .wnb__card-title {
    font-size: 1.2rem;
    margin: 0 0 0.2rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #111111;
  }
  #shopify-section-{{ section.id }} .wnb__card-price {
    font-size: 1.2rem;
    font-weight: 600;
    color: #2F7A55;
  }
  #shopify-section-{{ section.id }} .wnb__card-compare {
    font-size: 1.1rem;
    color: #E6E1E2;
    text-decoration: line-through;
    margin-left: 0.4rem;
  }
  #shopify-section-{{ section.id }} .wnb__add {
    flex-shrink: 0;
    border: none;
    background: {{ section.settings.cta_color }};
    color: {{ section.settings.cta_text_color }};
    border-radius: 999px;
    padding: 0.7rem 1.3rem;
    font-size: 1.2rem;
    font-weight: 600;
    cursor: pointer;
  }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .wnb__wrap { padding: 0 3.5rem; }
    #shopify-section-{{ section.id }} .wnb__item { flex: 0 0 22%; max-width: none; }
    #shopify-section-{{ section.id }} .wnb__arrow { display: flex; }
  }
</style>

<div class="wnb">
  {%- if section.settings.heading != blank -%}
    <h2 class="wnb__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="wnb__wrap">
    <button type="button" class="wnb__arrow wnb__arrow--prev" aria-label="Previous">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  <div class="wnb__track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign product = block.settings.product
        assign vid = block.settings.video
      -%}
      <div class="wnb__item" {{ block.shopify_attributes }}>
        <div class="wnb__video-wrap">
          {%- if vid != blank -%}
            {{ vid | video_tag: autoplay: false, loop: true, muted: true, controls: false, playsinline: true, preload: 'none', image_size: '533x' }}
          {%- endif -%}
          <button class="wnb__sound" aria-hidden="true" tabindex="-1">
            <svg class="wnb__icon-muted" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.59 3L14 9.41 15.41 8 18 10.59 20.59 8 22 9.41 19.41 12 22 14.59 20.59 16 18 13.41 15.41 16 14 14.59 16.59 12z"/></svg>
            <svg class="wnb__icon-sound" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="display:none"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05A4.5 4.5 0 0 0 16.5 12z"/></svg>
          </button>
        </div>

        {%- if product != blank -%}
          <div class="wnb__card">
            {%- if product.featured_image -%}
              <img class="wnb__card-img" src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" loading="lazy" width="44" height="55">
            {%- endif -%}
            <a class="wnb__card-info" href="{{ product.url }}">
              <p class="wnb__card-title">{{ product.title | escape }}</p>
              <span class="wnb__card-price">{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}</span>
              {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
                <span class="wnb__card-compare">{{ product.selected_or_first_available_variant.compare_at_price | money_without_trailing_zeros }}</span>
              {%- endif -%}
            </a>
            <button type="button" class="wnb__add" onclick="openQuickBuyModal('QuickBuyModal-{{ product.id }}', event)">Add</button>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
    <button type="button" class="wnb__arrow wnb__arrow--next" aria-label="Next">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
  <div class="wnb__dots" aria-label="Slide navigation"></div>
</div>

{%- comment -%} One quick-buy modal per unique product {%- endcomment -%}
{%- assign rendered_products = '' -%}
{%- for block in section.blocks -%}
  {%- assign product = block.settings.product -%}
  {%- if product != blank -%}
    {%- assign pid = product.id | append: ',' -%}
    {%- unless rendered_products contains pid -%}
      {%- assign rendered_products = rendered_products | append: pid -%}
      {% render 'quick-buy-modal', product: product %}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}

<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    var videos = section.querySelectorAll('.wnb__video-wrap video');

    /* Play only reels in view; saves data + battery on mobile */
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          var v = entry.target;
          if (entry.isIntersecting) {
            v.play().catch(function() {});
          } else {
            v.pause();
          }
        });
      }, { threshold: 0.4 });
      videos.forEach(function(v) { io.observe(v); });
    } else {
      videos.forEach(function(v) { v.play().catch(function() {}); });
    }

    /* Tap video to toggle sound */
    videos.forEach(function(v) {
      v.addEventListener('click', function() {
        v.muted = !v.muted;
        var wrap = v.closest('.wnb__video-wrap');
        wrap.querySelector('.wnb__icon-muted').style.display = v.muted ? '' : 'none';
        wrap.querySelector('.wnb__icon-sound').style.display = v.muted ? 'none' : '';
      });
    });

    /* Arrow navigation: scroll one reel per click */
    var track = section.querySelector('.wnb__track');
    var prevBtn = section.querySelector('.wnb__arrow--prev');
    var nextBtn = section.querySelector('.wnb__arrow--next');
    function reelStep() {
      var item = track && track.querySelector('.wnb__item');
      return item ? item.getBoundingClientRect().width + 19 : 300;
    }
    function atStart() { return track.scrollLeft <= 5; }
    function atEnd() { return track.scrollLeft + track.clientWidth >= track.scrollWidth - 5; }
    if (prevBtn && track) prevBtn.addEventListener('click', function() {
      if (atStart()) { track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' }); }
      else { track.scrollBy({ left: -reelStep(), behavior: 'smooth' }); }
    });
    if (nextBtn && track) nextBtn.addEventListener('click', function() {
      if (atEnd()) { track.scrollTo({ left: 0, behavior: 'smooth' }); }
      else { track.scrollBy({ left: reelStep(), behavior: 'smooth' }); }
    });

    /* Click-and-drag to swipe (mouse only; touch uses native scroll) */
    if (track) {
      var down = false, startX = 0, startScroll = 0, moved = false;
      track.addEventListener('pointerdown', function(e) {
        if (e.pointerType !== 'mouse') return;
        down = true; moved = false; startX = e.clientX; startScroll = track.scrollLeft;
        track.classList.add('is-dragging');
      });
      track.addEventListener('pointermove', function(e) {
        if (!down) return;
        var dx = e.clientX - startX;
        if (Math.abs(dx) > 3) moved = true;
        track.scrollLeft = startScroll - dx;
      });
      function endDrag() { down = false; track.classList.remove('is-dragging'); }
      track.addEventListener('pointerup', endDrag);
      track.addEventListener('pointerleave', endDrag);
      track.addEventListener('pointercancel', endDrag);
      /* Suppress the video sound-toggle / link click that follows a drag */
      track.addEventListener('click', function(e) { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
    }

    /* Pagination dots (pages) */
    var dotsWrap = section.querySelector('.wnb__dots');
    if (track && dotsWrap) {
      var rafD;
      var buildDots = function () {
        var pages = Math.max(1, Math.round(track.scrollWidth / track.clientWidth));
        dotsWrap.innerHTML = '';
        if (pages < 2) return;
        for (var i = 0; i < pages; i++) {
          var b = document.createElement('button');
          b.className = 'wnb__dot' + (i === 0 ? ' is-active' : '');
          b.type = 'button';
          b.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          (function (idx) { b.addEventListener('click', function () { track.scrollTo({ left: idx * track.clientWidth, behavior: 'smooth' }); }); })(i);
          dotsWrap.appendChild(b);
        }
      };
      var syncDots = function () {
        var idx = Math.round(track.scrollLeft / track.clientWidth);
        dotsWrap.querySelectorAll('.wnb__dot').forEach(function (d, i) { d.classList.toggle('is-active', i === idx); });
      };
      track.addEventListener('scroll', function () { cancelAnimationFrame(rafD); rafD = requestAnimationFrame(syncDots); });
      window.addEventListener('resize', function () { buildDots(); syncDots(); });
      buildDots();
    }
  })();
</script>

{% schema %}
{
  "name": "Watch & Buy",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Watch & Buy 🎬"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FDF7F5"
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "Add button color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Add button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Vertical 9:16 video (UGC / model reel)"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Watch & Buy",
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}
