{% comment %}
  Shop by Collection — large tappable cards with full-bleed photography
  and the collection name overlaid. Mobile: 1.2-card peek carousel
  (CSS scroll-snap, no JS). Desktop: grid.

  Also usable for a "Shop by Occasion" row — just point blocks at
  occasion collections (Brunch, Date Night, etc.).
{% endcomment %}

{%- liquid
  # Adapt card shape to the first card's image aspect ratio (uniform frame so
  # the row/carousel stays aligned). Falls back to 4:5 when no image is set.
  assign card_ratio = '4 / 5'
  for block in section.blocks
    assign first_img = block.settings.image | default: block.settings.collection.featured_image
    if first_img != blank
      assign card_ratio = first_img.aspect_ratio
      break
    endif
  endfor
-%}

<style>
  #shopify-section-{{ section.id }} .sbc {
    padding: {{ section.settings.padding_y }}px 0;
  }
  #shopify-section-{{ section.id }} .sbc__heading {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0 0 2rem;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .sbc__track {
    display: flex;
    gap: 1.2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .sbc__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .sbc__wrap {
    position: relative;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  #shopify-section-{{ section.id }} .sbc__dots { display: flex; justify-content: center; gap: 8px; margin-top: 1.6rem; }
  #shopify-section-{{ section.id }} .sbc__dot { width: 8px; height: 8px; border-radius: 50%; border: none; padding: 0; background: var(--elora-grey-line, #E6E1E2); cursor: pointer; transition: background 0.2s, width 0.2s; }
  #shopify-section-{{ section.id }} .sbc__dot.is-active { background: var(--elora-maroon, #111111); width: 20px; border-radius: 4px; }
  #shopify-section-{{ section.id }} .sbc__card {
    position: relative;
    flex: 0 0 80%;
    scroll-snap-align: start;
    border-radius: {{ section.settings.corner_radius }}px;
    overflow: hidden;
    aspect-ratio: {{ card_ratio }};
    display: block;
    background: #FEFAFA;
  }
  #shopify-section-{{ section.id }} .sbc__track.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
    user-select: none;
  }
  #shopify-section-{{ section.id }} .sbc__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  #shopify-section-{{ section.id }} .sbc__card:hover img { transform: scale(1.04); }
  #shopify-section-{{ section.id }} .sbc__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 1.6rem;
    background: linear-gradient(to top, rgba(0,0,0,0.45) 0%, rgba(0,0,0,0) 45%);
  }
  #shopify-section-{{ section.id }} .sbc__label {
    color: #fff;
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .sbc__wrap { padding: 0 5rem; }
    #shopify-section-{{ section.id }} .sbc__track {
      display: grid;
      grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
      overflow: visible;
    }
    #shopify-section-{{ section.id }} .sbc__card { flex: none; }
    #shopify-section-{{ section.id }} .sbc__dots { display: none; }
  }
</style>

<div class="sbc">
  {%- if section.settings.heading != blank -%}
    <h2 class="sbc__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="sbc__wrap">
  <div class="sbc__track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign coll = block.settings.collection
        assign card_image = block.settings.image | default: coll.featured_image
        assign card_label = block.settings.label | default: coll.title
        assign card_url = block.settings.link | default: coll.url
      -%}
      <a class="sbc__card" href="{{ card_url | default: '#' }}" {{ block.shopify_attributes }}>
        {%- if card_image -%}
          <img
            srcset="{{ card_image | image_url: width: 400 }} 400w, {{ card_image | image_url: width: 600 }} 600w, {{ card_image | image_url: width: 900 }} 900w"
            sizes="(min-width: 750px) {{ 100 | divided_by: section.settings.desktop_columns }}vw, 80vw"
            src="{{ card_image | image_url: width: 600 }}"
            alt="{{ card_label | escape }}"
            loading="lazy"
            width="{{ card_image.width }}"
            height="{{ card_image.height }}"
          >
        {%- endif -%}
        <div class="sbc__overlay">
          <p class="sbc__label">{{ card_label | escape }}</p>
        </div>
      </a>
    {%- endfor -%}
  </div>
    <div class="sbc__dots" aria-label="Slide navigation"></div>
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    var track = section.querySelector('.sbc__track');
    var dotsWrap = section.querySelector('.sbc__dots');
    if (!track || !dotsWrap) return;
    function buildDots() {
      var pages = Math.max(1, Math.round(track.scrollWidth / track.clientWidth));
      dotsWrap.innerHTML = '';
      if (pages < 2) return;
      for (var i = 0; i < pages; i++) {
        var b = document.createElement('button');
        b.className = 'sbc__dot' + (i === 0 ? ' is-active' : '');
        b.type = 'button';
        b.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        (function (idx) { b.addEventListener('click', function () { track.scrollTo({ left: idx * track.clientWidth, behavior: 'smooth' }); }); })(i);
        dotsWrap.appendChild(b);
      }
    }
    function syncDots() {
      var idx = Math.round(track.scrollLeft / track.clientWidth);
      dotsWrap.querySelectorAll('.sbc__dot').forEach(function (d, i) { d.classList.toggle('is-active', i === idx); });
    }
    var raf;
    track.addEventListener('scroll', function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(syncDots); });
    window.addEventListener('resize', function () { buildDots(); syncDots(); });
    buildDots();

    /* Click-and-drag to swipe (mouse only; touch uses native scroll).
       Guarded to only engage when the track is horizontally scrollable, so it
       never suppresses card clicks on the desktop grid. */
    var down = false, startX = 0, startScroll = 0, moved = false;
    track.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse' || track.scrollWidth <= track.clientWidth) return;
      down = true; moved = false; startX = e.clientX; startScroll = track.scrollLeft;
      track.classList.add('is-dragging');
    });
    track.addEventListener('pointermove', function (e) {
      if (!down) return;
      var dx = e.clientX - startX;
      if (Math.abs(dx) > 3) moved = true;
      track.scrollLeft = startScroll - dx;
    });
    function endDrag() { down = false; track.classList.remove('is-dragging'); }
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointerleave', endDrag);
    track.addEventListener('pointercancel', endDrag);
    track.addEventListener('click', function (e) { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
  })();
</script>

{% schema %}
{
  "name": "Shop by Collection",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Collection"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overrides the collection's featured image. Use full-bleed model photography (4:5)."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Overrides the collection title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Overrides the collection URL"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop by Collection",
      "blocks": [
        { "type": "card", "settings": { "label": "Tops" } },
        { "type": "card", "settings": { "label": "Dresses" } },
        { "type": "card", "settings": { "label": "Co-ords" } }
      ]
    }
  ]
}
{% endschema %}
