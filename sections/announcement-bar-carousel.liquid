{%- liquid
  assign layout = section.settings.layout
  assign padding = section.settings.padding
  assign show_top_border = section.settings.show_top_border
  assign show_bottom_border = section.settings.show_bottom_border
  assign border_color = section.settings.border_color
  assign text_color = section.settings.color
  assign bg_color = section.settings.bg_color
  assign color_scheme = section.settings.color_scheme
  assign text_caps = section.settings.text_caps
  assign text_size = section.settings.text_size
  assign letter_spacing = section.settings.letter_spacing
  assign message_spacing = section.settings.message_spacing
  assign bg_image = section.settings.bg_image
  assign marquee_speed = section.settings.marquee_speed
  assign direction = section.settings.direction
  assign slider_speed = section.settings.slider_speed
  assign show_arrows = section.settings.show_arrows

  assign base_font_px = 14
  assign font_size_px = base_font_px | times: text_size | divided_by: 100
  assign marquee_duration = 3000 | divided_by: marquee_speed
  assign marquee_duration_mobile = marquee_duration | times: 6 | divided_by: 10
-%}

<style>
  /* Container */
  #shopify-section-{{ section.id }} {
    {% if show_top_border %}border-top: 1px solid {{ border_color | default: 'rgba(var(--color-foreground), 0.08)' }};{% endif %}
    {% if show_bottom_border %}border-bottom: 1px solid {{ border_color | default: 'rgba(var(--color-foreground), 0.08)' }};{% endif %}
  }

  #shopify-section-{{ section.id }} .ann-bar {
    padding: {{ padding }}px 0;
    overflow: hidden;
    position: relative;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: {{ font_size_px }}px;
    line-height: 1.4;
    {% if letter_spacing != 0 %}letter-spacing: {{ letter_spacing | times: 1.0 | divided_by: 1000.0 }}em;{% endif %}
    {% if text_caps %}text-transform: uppercase;{% endif %}
    {% if text_color != blank %}color: {{ text_color }};{% endif %}
    {% if bg_color != blank %}background-color: {{ bg_color }};{% endif %}
  }

  /* Background image */
  {% if bg_image %}
    #shopify-section-{{ section.id }} .ann-bar {
      background-image: url('{{ bg_image | image_url: width: 1920 }}');
      background-size: cover;
      background-position: center;
    }
  {% endif %}

  /* Richtext resets */
  #shopify-section-{{ section.id }} .ann-text p { display: inline; margin: 0; }
  #shopify-section-{{ section.id }} .ann-text a { color: inherit; text-decoration: underline; }

  /* === MARQUEE === */
  #shopify-section-{{ section.id }} .ann-marquee {
    display: flex;
    align-items: center;
    white-space: nowrap;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .ann-marquee__track {
    display: flex;
    width: max-content;
    animation: ann-scroll-{{ section.id }} {{ marquee_duration }}s linear infinite;
  }
  /* Two identical halves; the animation moves by exactly one half (-50%),
     so the loop is seamless — no gap, always scrolling. */
  #shopify-section-{{ section.id }} .ann-marquee__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  {% if direction == 'ticker-rtl' %}
    #shopify-section-{{ section.id }} .ann-marquee__track { animation-direction: reverse; }
  {% endif %}
  #shopify-section-{{ section.id }} .ann-bar:hover .ann-marquee__track {
    animation-play-state: paused;
  }
  #shopify-section-{{ section.id }} .ann-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 {{ message_spacing }}px;
    white-space: nowrap;
  }
  @keyframes ann-scroll-{{ section.id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Faster marquee on mobile */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ann-marquee__track {
      animation-duration: {{ marquee_duration_mobile }}s;
    }
  }

  /* Accessibility: stop motion when the user asks for reduced motion */
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .ann-marquee__track { animation: none !important; }
    #shopify-section-{{ section.id }} .ann-slider__slide { transition: none !important; }
  }

  /* === SLIDER === */
  #shopify-section-{{ section.id }} .ann-slider {
    position: relative;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .ann-slider__track {
    position: relative;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .ann-slider__slide {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    opacity: 0;
    position: absolute;
    top: 0; left: 0; right: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .ann-slider__slide.ann-active {
    opacity: 1;
    position: relative;
    pointer-events: auto;
  }
  #shopify-section-{{ section.id }} .ann-slider__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    padding: 8px;
    z-index: 2;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  #shopify-section-{{ section.id }} .ann-slider__arrow:hover { opacity: 1; }
  #shopify-section-{{ section.id }} .ann-slider__arrow--prev { left: 8px; }
  #shopify-section-{{ section.id }} .ann-slider__arrow--next { right: 8px; }

  /* === ICONS === */
  #shopify-section-{{ section.id }} .ann-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .ann-icon svg {
    width: 100%;
    height: 100%;
  }
  #shopify-section-{{ section.id }} .ann-icon img {
    object-fit: contain;
    display: block;
  }

  /* === HIGHLIGHT EFFECTS (applied to <em> inside richtext) === */
  #shopify-section-{{ section.id }} .hl--italics em { font-style: italic; }
  #shopify-section-{{ section.id }} .hl--highlight em {
    font-style: normal;
    background-color: var(--hl-bg, rgba(var(--color-foreground), 0.1));
    color: var(--hl-text, inherit);
    padding: 0.1em 0.3em;
    border-radius: 3px;
  }
  #shopify-section-{{ section.id }} .hl--highlight-color em {
    font-style: normal;
    color: var(--hl-color, currentColor);
  }
  #shopify-section-{{ section.id }} .hl--underline em {
    font-style: normal;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  #shopify-section-{{ section.id }} .hl--underline-hand-drawn em {
    font-style: normal;
    text-decoration: underline wavy;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
  #shopify-section-{{ section.id }} .hl--squiggle em {
    font-style: normal;
    text-decoration: underline wavy;
    text-underline-offset: 3px;
  }
  #shopify-section-{{ section.id }} .hl--circle em {
    font-style: normal;
    border: 2px solid currentColor;
    border-radius: 50%;
    padding: 0.05em 0.4em;
  }
  #shopify-section-{{ section.id }} .hl--circle-hand-drawn em {
    font-style: normal;
    border: 2px solid currentColor;
    border-radius: 43% 57% 55% 45% / 56% 44% 56% 44%;
    padding: 0.05em 0.4em;
  }
  #shopify-section-{{ section.id }} .hl--stroke em {
    font-style: normal;
    -webkit-text-stroke: 1px currentColor;
    -webkit-text-fill-color: transparent;
  }
  #shopify-section-{{ section.id }} .hl--alternate-font em {
    font-style: normal;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
  }
  /* Highlight color overrides via custom properties */
  #shopify-section-{{ section.id }} .hl--underline em { text-decoration-color: var(--hl-color, currentColor); }
  #shopify-section-{{ section.id }} .hl--underline-hand-drawn em { text-decoration-color: var(--hl-color, currentColor); }
  #shopify-section-{{ section.id }} .hl--squiggle em { text-decoration-color: var(--hl-color, currentColor); }
  #shopify-section-{{ section.id }} .hl--circle em { border-color: var(--hl-color, currentColor); }
  #shopify-section-{{ section.id }} .hl--circle-hand-drawn em { border-color: var(--hl-color, currentColor); }
  #shopify-section-{{ section.id }} .hl--stroke em { -webkit-text-stroke-color: var(--hl-color, currentColor); }

  /* === IMAGE BLOCK === */
  #shopify-section-{{ section.id }} .ann-image img { display: block; height: auto; }
  #shopify-section-{{ section.id }} .ann-image a { display: inline-block; }

  /* === TARGET FILTERING === */
  #shopify-section-{{ section.id }} .ann-block-hidden { display: none !important; }
</style>

{%- if section.blocks.size > 0 -%}
  <div class="ann-bar page-width color-{{ color_scheme }} gradient"
       role="region"
       aria-label="{{ 'sections.header.announcement' | t }}">

    {%- comment -%}--- Capture each block's rendered content ---{%- endcomment -%}
    {%- capture block_contents -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign has_target = false
          if block.settings.target_url_enabled or block.settings.target_referrer_enabled or block.settings.target_device_enabled
            assign has_target = true
          endif
        -%}
        <div class="{% if layout == 'marquee' %}ann-marquee__item{% else %}ann-slider__slide{% if forloop.first %} ann-active{% endif %}{% endif %}"
             {{ block.shopify_attributes }}
             {% if has_target %}
               data-target-url-enabled="{{ block.settings.target_url_enabled }}"
               {% if block.settings.target_url_enabled %}data-target-url="{{ block.settings.target_url }}"{% endif %}
               data-target-referrer-enabled="{{ block.settings.target_referrer_enabled }}"
               {% if block.settings.target_referrer_enabled %}data-target-referrer="{{ block.settings.target_referrer }}"{% endif %}
               data-target-device-enabled="{{ block.settings.target_device_enabled }}"
               {% if block.settings.target_device_enabled %}data-target-device="{{ block.settings.target_device }}"{% endif %}
             {% endif %}>

          {%- case block.type -%}

            {%- when 'text' -%}
              {%- if block.settings.icon_image -%}
                <span class="ann-icon" style="width: {{ block.settings.icon_width }}px; height: {{ block.settings.icon_width }}px;">
                  <img src="{{ block.settings.icon_image | image_url: width: 120 }}"
                       alt="" width="{{ block.settings.icon_width }}" height="{{ block.settings.icon_width }}" loading="lazy">
                </span>
              {%- elsif block.settings.icon_name != 'none' -%}
                <span class="ann-icon" style="width: {{ block.settings.icon_width }}px; height: {{ block.settings.icon_width }}px;">
                  {%- render 'icon-accordion', icon: block.settings.icon_name -%}
                </span>
              {%- endif -%}
              <span class="ann-text hl--{{ block.settings.heading_highlight_type }}">
                {{- block.settings.text -}}
              </span>

            {%- when 'message' -%}
              <span class="ann-text" data-free-shipping-block data-free-shipping-template="{{ block.settings.message | escape }}">
                {{- block.settings.message | escape -}}
              </span>

            {%- when 'countdown' -%}
              <span class="ann-text ann-countdown" data-countdown-end="{{ block.settings.end_time | escape }}" {% if block.settings.hide_on_expiry %}data-countdown-hide{% endif %}>
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" style="color: inherit; text-decoration: none;">{%- endif -%}
                {{- block.settings.text -}}
                {%- if block.settings.code != blank %} <strong class="ann-countdown__code">{{ block.settings.code }}</strong>{% endif %}
                <strong class="ann-countdown__timer" data-countdown-display>--:--:--</strong>
                {%- if block.settings.link != blank -%}</a>{%- endif -%}
              </span>

            {%- when 'custom' -%}
              <span class="ann-text ann-custom-html">
                {{- block.settings.text -}}
              </span>

            {%- when 'image' -%}
              {%- if block.settings.image -%}
                <span class="ann-image">
                  {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
                  <img src="{{ block.settings.image | image_url: width: 360 }}"
                       alt="{{ block.settings.image.alt | escape }}"
                       width="{{ block.settings.image_width }}"
                       loading="lazy"
                       style="width: {{ block.settings.image_width }}px;">
                  {%- if block.settings.link != blank -%}</a>{%- endif -%}
                </span>
              {%- endif -%}

          {%- endcase -%}
        </div>
      {%- endfor -%}
    {%- endcapture -%}

    {%- comment -%}--- Render layout mode ---{%- endcomment -%}
    {%- if layout == 'marquee' -%}
      <div class="ann-marquee">
        <div class="ann-marquee__track">
          <div class="ann-marquee__group">
            {{ block_contents }}{{ block_contents }}{{ block_contents }}{{ block_contents }}{{ block_contents }}{{ block_contents }}
          </div>
          <div class="ann-marquee__group" aria-hidden="true">
            {{ block_contents }}{{ block_contents }}{{ block_contents }}{{ block_contents }}{{ block_contents }}{{ block_contents }}
          </div>
        </div>
      </div>
    {%- else -%}
      <div class="ann-slider" data-slider-speed="{{ slider_speed }}">
        {%- if show_arrows and section.blocks.size > 1 -%}
          <button class="ann-slider__arrow ann-slider__arrow--prev" type="button" aria-label="{{ 'sections.announcements.previous_announcement' | t }}">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7.5 9L4.5 6L7.5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {%- endif -%}

        <div class="ann-slider__track">
          {{ block_contents }}
        </div>

        {%- if show_arrows and section.blocks.size > 1 -%}
          <button class="ann-slider__arrow ann-slider__arrow--next" type="button" aria-label="{{ 'sections.announcements.next_announcement' | t }}">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    /* --- Target filtering (skip in theme editor) --- */
    {% unless request.design_mode %}
      var blocks = section.querySelectorAll('[data-target-url-enabled], [data-target-referrer-enabled], [data-target-device-enabled]');
      var path = window.location.pathname;
      var ref = document.referrer;
      var isMobile = window.innerWidth < 750;

      blocks.forEach(function(block) {
        var hide = false;
        if (block.dataset.targetUrlEnabled === 'true' && block.dataset.targetUrl) {
          var target = block.dataset.targetUrl;
          if (path !== target && path !== target + '/' && path.replace(/\/$/, '') !== target.replace(/\/$/, '')) {
            hide = true;
          }
        }
        if (block.dataset.targetReferrerEnabled === 'true' && block.dataset.targetReferrer) {
          if (!ref.includes(block.dataset.targetReferrer)) hide = true;
        }
        if (block.dataset.targetDeviceEnabled === 'true' && block.dataset.targetDevice) {
          if (block.dataset.targetDevice === 'mobile' && !isMobile) hide = true;
          if (block.dataset.targetDevice === 'desktop' && isMobile) hide = true;
        }
        if (hide) block.classList.add('ann-block-hidden');
      });
    {% endunless %}

    /* --- Slider auto-rotation --- */
    var slider = section.querySelector('.ann-slider');
    if (slider) {
      var allSlides = slider.querySelectorAll('.ann-slider__slide');
      var speed = parseInt(slider.dataset.sliderSpeed, 10) * 1000;
      var current = 0;
      var interval;

      function getVisibleSlides() {
        return Array.from(allSlides).filter(function(s) {
          return !s.classList.contains('ann-block-hidden');
        });
      }

      function showSlide(index) {
        var visible = getVisibleSlides();
        if (visible.length === 0) return;
        allSlides.forEach(function(s) { s.classList.remove('ann-active'); });
        current = ((index % visible.length) + visible.length) % visible.length;
        visible[current].classList.add('ann-active');
      }

      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function startAutoplay() {
        if (!reduceMotion && getVisibleSlides().length > 1) {
          interval = setInterval(function() { showSlide(current + 1); }, speed);
        }
      }
      function stopAutoplay() { clearInterval(interval); }

      var prev = slider.querySelector('.ann-slider__arrow--prev');
      var next = slider.querySelector('.ann-slider__arrow--next');
      if (prev) prev.addEventListener('click', function() { stopAutoplay(); showSlide(current - 1); startAutoplay(); });
      if (next) next.addEventListener('click', function() { stopAutoplay(); showSlide(current + 1); startAutoplay(); });

      slider.addEventListener('mouseenter', stopAutoplay);
      slider.addEventListener('mouseleave', startAutoplay);

      /* Initialize: ensure first visible slide is active */
      showSlide(0);
      startAutoplay();
    }

    /* --- Free shipping message --- */
    var freeShipBlocks = section.querySelectorAll('[data-free-shipping-block]');
    if (freeShipBlocks.length > 0) {
      var threshold = {{ settings.free_shipping_threshold | default: 599 | times: 100 }};

      function updateFreeShipping() {
        fetch('/cart.js', { credentials: 'same-origin' })
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            var remaining = Math.max(0, threshold - cart.total_price);
            freeShipBlocks.forEach(function(block) {
              var template = block.dataset.freeShippingTemplate;
              if (remaining > 0) {
                var formatted = '₹' + Math.ceil(remaining / 100);
                block.textContent = template.replace('||amount||', formatted);
              } else {
                block.textContent = 'You qualify for FREE shipping!';
              }
            });
          })
          .catch(function() {});
      }

      updateFreeShipping();
      document.addEventListener('cart:updated', updateFreeShipping);
    }

    /* --- Countdown timer --- */
    var countdowns = section.querySelectorAll('[data-countdown-end]');
    if (countdowns.length > 0) {
      function pad(n) { return n < 10 ? '0' + n : '' + n; }
      function tick() {
        var now = Date.now();
        countdowns.forEach(function(el) {
          var end = new Date(el.dataset.countdownEnd).getTime();
          var display = el.querySelector('[data-countdown-display]');
          if (!display || isNaN(end)) return;
          var diff = end - now;
          if (diff <= 0) {
            if (el.hasAttribute('data-countdown-hide')) {
              var slide = el.closest('.ann-slider__slide, .ann-marquee__item');
              if (slide) slide.classList.add('ann-block-hidden');
            } else {
              display.textContent = '00:00:00';
            }
            return;
          }
          var d = Math.floor(diff / 86400000);
          var h = Math.floor((diff % 86400000) / 3600000);
          var m = Math.floor((diff % 3600000) / 60000);
          var s = Math.floor((diff % 60000) / 1000);
          display.textContent = (d > 0 ? d + 'd ' : '') + pad(h) + ':' + pad(m) + ':' + pad(s);
        });
      }
      tick();
      setInterval(tick, 1000);
    }
  })();
</script>

{% schema %}
{
  "name": "Announcement Carousel",
  "class": "announcement-bar-static",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "marquee",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "marquee",
          "label": "Marquee"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show top border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show bottom border",
      "default": true
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "default": 10,
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "slider_speed",
      "label": "Autoplay speed",
      "unit": "sec",
      "min": 5,
      "max": 20,
      "step": 1,
      "default": 7
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": false
    },
    {
      "type": "header",
      "content": "Marquee"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Autoplay speed",
      "unit": "%",
      "min": 50,
      "max": 300,
      "step": 25,
      "default": 100
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Text direction",
      "default": "ticker-ltr",
      "options": [
        { "value": "ticker-ltr", "label": "Left to right" },
        { "value": "ticker-rtl", "label": "Right to left" }
      ]
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "checkbox",
      "id": "text_caps",
      "label": "Uppercase text",
      "default": false
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Size",
      "default": 100,
      "min": 50,
      "max": 500,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "default": 0,
      "min": -25,
      "max": 200,
      "unit": "%",
      "step": 25
    },
    {
      "type": "range",
      "id": "message_spacing",
      "label": "Space between messages",
      "info": "Marquee only",
      "default": 25,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text",
      "default": "#FFFFFF",
      "alpha": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#111111",
      "alpha": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "alpha": true
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    }
  ],
  "blocks": [
    {
      "type": "countdown",
      "name": "Countdown offer",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Launch offer! Extra 10% off with</p>"
        },
        {
          "type": "text",
          "id": "code",
          "label": "Coupon code",
          "default": "ELORA10"
        },
        {
          "type": "text",
