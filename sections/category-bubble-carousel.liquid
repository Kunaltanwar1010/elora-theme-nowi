<div id="category-bubble-{{ section.id }}" class="category-bubble-section">
  <div class="page-width">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="category-bubble-heading">
        {% if section.settings.heading != blank %}
          <h2 class="category-bubble-title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="category-bubble-subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="category-bubble-carousel" role="list">
        {% for block in section.blocks %}
          {% assign link = block.settings.link %}
          {% if link != blank %}
            <a
              href="{{ link }}"
              class="category-bubble-card"
              role="listitem"
              {{ block.shopify_attributes }}
            >
          {% else %}
            <div class="category-bubble-card" role="listitem" {{ block.shopify_attributes }}>
          {% endif %}

            <div class="category-bubble-image-wrap">
              {% if block.settings.image != blank %}
                {{ block.settings.image
                  | image_url: width: 320
                  | image_tag:
                    alt: block.settings.title,
                    loading: 'lazy',
                    class: 'category-bubble-image'
                }}
              {% else %}
                <div class="category-bubble-placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
            </div>

            {% if block.settings.title != blank %}
              <div class="category-bubble-label">
                {{ block.settings.title | escape }}
              </div>
            {% endif %}

            {% if block.settings.starting_text != blank %}
              <div class="category-bubble-starting">
                {{ block.settings.starting_text }}
              </div>
            {% endif %}

          {% if link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <p>No categories added yet.</p>
    {% endif %}
  </div>
</div>

{% style %}
#category-bubble-{{ section.id }} {
  padding: 1.25rem 0 0.75rem;
  --bubble-size: {{ section.settings.bubble_size | default: 96 }}px;
}

#category-bubble-{{ section.id }} .category-bubble-heading {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  margin-bottom: 1rem;
}

#category-bubble-{{ section.id }} .category-bubble-title {
  font-size: 1.1rem;
  font-weight: 600;
  margin: 0;
}

#category-bubble-{{ section.id }} .category-bubble-subtitle {
  margin: 0;
  font-size: 0.9rem;
  color: rgba(0,0,0,0.65);
}

#category-bubble-{{ section.id }} .category-bubble-carousel {
  display: flex;
  gap: 1.25rem;
  overflow-x: auto;
  padding: 0.25rem 0 0.75rem;
  -webkit-overflow-scrolling: touch;
  scroll-snap-type: x mandatory;
}
#category-bubble-{{ section.id }} .category-bubble-carousel::-webkit-scrollbar {
  display: none;
}
#category-bubble-{{ section.id }} .category-bubble-carousel {
  scrollbar-width: none;
}

#category-bubble-{{ section.id }} .category-bubble-card {
  scroll-snap-align: start;
  flex: 0 0 auto;
  text-align: center;
  text-decoration: none;
  color: inherit;
  font-family: inherit;
}

#category-bubble-{{ section.id }} .category-bubble-image-wrap {
  width: var(--bubble-size);
  height: var(--bubble-size);
  border-radius: 9999px;
  margin: 0 auto 0.35rem;
  background: radial-gradient(circle at 30% 20%, #ffe7f1 0, #ffc6dd 40%, #ffeef7 100%);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 6px 12px rgba(0,0,0,0.05);
}

#category-bubble-{{ section.id }} .category-bubble-image {
  width: 100%;
  height: auto;
  object-fit: cover;
}

/* Dummy / placeholder image */
#category-bubble-{{ section.id }} .category-bubble-placeholder {
  width: 90%;
  height: 90%;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
#category-bubble-{{ section.id }} .category-bubble-placeholder .placeholder-svg {
  width: 100%;
  height: 100%;
  opacity: 0.8;
}

#category-bubble-{{ section.id }} .category-bubble-label {
  font-size: 0.95rem;
  font-weight: 600;
  margin-bottom: 0.05rem;
}

#category-bubble-{{ section.id }} .category-bubble-starting {
  font-size: 0.9rem;
  color: rgba(0,0,0,0.8);
}

@media (max-width: 480px) {
  #category-bubble-{{ section.id }} .category-bubble-label {
    font-size: 0.9rem;
  }
  #category-bubble-{{ section.id }} .category-bubble-starting {
    font-size: 0.85rem;
  }
}
{% endstyle %}

{% schema %}
{
  "name": "Category bubble carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Heading"
    },
    {
      "type": "range",
      "id": "bubble_size",
      "label": "Bubble size (px)",
      "min": 72,
      "max": 160,
      "step": 4,
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Dresses"
        },
        {
          "type": "text",
          "id": "starting_text",
          "label": "Starting price text",
          "default": "Starting ₹199"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Category bubble carousel",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Dresses",
            "starting_text": "Starting ₹199"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Jeans",
            "starting_text": "Starting ₹399"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Sweaters",
            "starting_text": "Starting ₹399"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Kurtis & Kurtas",
            "starting_text": "Starting ₹199"
          }
        }
      ]
    }
  ]
}
{% endschema %}
