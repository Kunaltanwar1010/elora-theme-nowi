{% comment %}
  Collection Top Bar Section
  - Sticky header with back button, title, search, cart
  - Shows/hides on scroll (like Shopify's main header)
  - Uses Tailwind CSS
{% endcomment %}

<style>
  /* Hide collection-top-bar on desktop (990px+) - show default header instead */
  @media (min-width: 990px) {
    .collection-top-bar {
      display: none !important;
    }
  }

  /* Hide default header on mobile only (<990px) when collection top bar is present */
  @media (max-width: 989px) {
    body:has(.collection-top-bar) .shopify-section-header-group,
    body:has(.collection-top-bar) .section-header {
      display: none !important;
    }
  }

  /* Sticky positioning with show/hide on scroll */
  .section-collection-top-bar {
    position: sticky !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100vw !important;
    margin-left: calc(-50vw + 50%) !important;
    background-color: {{ section.settings.background_color | default: '#ffffff' }};
    z-index: 100;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .section-collection-top-bar.scrolled {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }

  /* Hidden state - slides up when scrolling down */
  .section-collection-top-bar.header-hidden {
    transform: translateY(-100%);
  }

  /* Visible state - slides down when scrolling up */
  .section-collection-top-bar.header-visible {
    transform: translateY(0);
  }

  /* Container with proper max-width centering */
  .collection-top-bar {
    position: relative;
    background-color: {{ section.settings.background_color | default: '#ffffff' }} !important;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
  }

  /* Desktop: constrain to page width */
  @media (min-width: 990px) {
    .collection-top-bar {
      max-width: var(--page-width);
    }
  }

  /* Title truncate with fade effect */
  .page-title {
    position: relative;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-heading-family);
    letter-spacing: 0.02em;
    line-height: 1;
    margin: 0;
  }

  /* Collection top bar header layout */
  .collection-top-bar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 1.2rem;
    gap: 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    min-height: 56px;
  }

  /* Header icons container - match header styling */
  .collection-top-bar .header__icons {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* Back button styling */
  .collection-top-bar .back-button {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: -1.2rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .collection-top-bar .back-button .svg-wrapper {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .collection-top-bar .back-button .icon {
    width: 2rem;
    height: 2rem;
    transform: rotate(180deg);
  }
</style>

{%- liquid
  assign target_collection = collection
  if section.settings.collection_handle != blank
    assign target_collection = collections[section.settings.collection_handle]
  endif

  assign page_title = section.settings.custom_title
  if page_title == blank and target_collection
    assign page_title = target_collection.title
  endif
-%}

<div class="collection-top-bar" data-section-id="{{ section.id }}">
  <!-- HEADER -->
  <header class="collection-top-bar-header">
    <!-- Back button -->
    {% if section.settings.show_back_button %}
      <button
        type="button"
        onclick="handleBackClick()"
        class="back-button link focus-inset"
        aria-label="Go back">
        <span class="svg-wrapper">
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
      </button>
    {% endif %}

    <!-- Page title -->
    <h1 class="page-title" style="flex: 1; font-size: {{ section.settings.title_font_size }}px; font-weight: {{ section.settings.title_font_weight }};">
      {{ page_title }}
    </h1>

    <!-- Action buttons - uses Dawn header__icon classes for consistent styling -->
    <div class="header__icons">
      <!-- Search -->
      {% if section.settings.show_search %}
        <a
          href="{{ routes.search_url }}"
          class="header__icon header__icon--search link focus-inset"
          aria-label="{{ 'general.search.search' | t }}">
          <span class="svg-wrapper">
            {{- 'icon-search.svg' | inline_asset_content -}}
          </span>
        </a>
      {% endif %}

      <!-- Wishlist - Using Swish app component for consistent styling -->
      {% if section.settings.show_wishlist %}
        <div class="header__icon header__icon--wishlist" style="--icon-size: 22px; --icon-fill: transparent; --icon-stroke: #000000; --icon-stroke-width: 1px;">
          <script type="module" src="https://cdn.shopify.com/extensions/019a6435-2700-705e-910c-5eafab3282ce/swish-app-216/assets/block-wishlist-link.js"></script>
          <wishlist-link-block wk-skip="" wk-headless="">
            <a href="/apps/wishlist" class="wk-button" rel="noopener noreferrer nofollow" aria-label="Wishlist">
              <span class="wk-icon">
                <svg viewBox="0 0 64 64">
                  <path d="M32.012,59.616c-1.119-.521-2.365-1.141-3.707-1.859a79.264,79.264,0,0,1-11.694-7.614C6.316,42,.266,32.6.254,22.076,0.244,12.358,7.871,4.506,17.232,4.5a16.661,16.661,0,0,1,11.891,4.99l2.837,2.889,2.827-2.9a16.639,16.639,0,0,1,11.874-5.02h0c9.368-.01,17.008,7.815,17.021,17.539,0.015,10.533-6.022,19.96-16.312,28.128a79.314,79.314,0,0,1-11.661,7.63C34.369,58.472,33.127,59.094,32.012,59.616Z"></path>
                </svg>
              </span>
            </a>
          </wishlist-link-block>
        </div>
      {% endif %}

      <!-- Account -->
      {% if section.settings.show_account %}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="header__icon header__icon--account link focus-inset"
          aria-label="{%- if customer -%}{{ 'customer.account_fallback' | t }}{%- else -%}{{ 'customer.log_in' | t }}{%- endif -%}">
          <span class="svg-wrapper">
            {{- 'icon-account.svg' | inline_asset_content -}}
          </span>
        </a>
      {% endif %}

      <!-- Cart -->
      {% if section.settings.show_cart %}
        <a
          href="{{ routes.cart_url }}"
          class="header__icon header__icon--cart link focus-inset js-collection-top-bar-cart"
          aria-label="{{ 'templates.cart.cart' | t }}">
          <span class="svg-wrapper">
            {%- if cart == empty -%}
              {{- 'icon-cart-empty.svg' | inline_asset_content -}}
            {%- else -%}
              {{- 'icon-cart.svg' | inline_asset_content -}}
            {%- endif -%}
          </span>
          <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
          {%- if cart != empty -%}
            <div class="cart-count-bubble">
              {%- if cart.item_count < 100 -%}
                <span aria-hidden="true">{{ cart.item_count }}</span>
              {%- endif -%}
              <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            </div>
          {%- endif -%}
        </a>
      {% endif %}
    </div>
  </header>
</div>

<script>
  (function() {
    // Handle back button click - use browser history for proper back navigation
    window.handleBackClick = function() {
      // Show loader before navigating
      if (window.PageLoader) {
        window.PageLoader.show();
      }

      // Check if there's browser history to go back to
      if (window.history.length > 1) {
        window.history.back();
      } else {
        // Fallback to homepage if no history
        window.location.href = '/';
      }
    };

    const section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    const sectionWrapper = section.closest('.section-collection-top-bar');
    if (!sectionWrapper) return;

    // Sticky header on scroll up variables
    let currentScrollTop = 0;
    let headerHeight = sectionWrapper.offsetHeight;
    let isHidden = false;

    // Store header height for CSS calculations
    document.documentElement.style.setProperty('--collection-top-bar-height', `${headerHeight}px`);

    function handleScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      // Add shadow when scrolled
      if (scrollTop > 10) {
        sectionWrapper.classList.add('scrolled');
      } else {
        sectionWrapper.classList.remove('scrolled');
      }

      // Sticky header show/hide logic (like Shopify's main header)
      if (scrollTop > headerHeight) {
        // Past the header height
        if (scrollTop > currentScrollTop) {
          // Scrolling DOWN - hide the header
          if (!isHidden) {
            sectionWrapper.classList.add('header-hidden');
            sectionWrapper.classList.remove('header-visible');
            isHidden = true;
          }
        } else {
          // Scrolling UP - show the header
          if (isHidden) {
            sectionWrapper.classList.remove('header-hidden');
            sectionWrapper.classList.add('header-visible');
            isHidden = false;
          }
        }
      } else {
        // At the top - reset to normal state
        sectionWrapper.classList.remove('header-hidden', 'header-visible');
        isHidden = false;
      }

      currentScrollTop = scrollTop;
    }

    window.addEventListener('scroll', handleScroll, { passive: true });

    // Update header height on resize
    window.addEventListener('resize', () => {
      headerHeight = sectionWrapper.offsetHeight;
      document.documentElement.style.setProperty('--collection-top-bar-height', `${headerHeight}px`);
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Collection Top Bar",
  "class": "section-collection-top-bar",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection_handle",
      "label": "Collection",
      "info": "Optional. Leave empty to use the current collection on collection pages."
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Custom Title",
      "info": "Leave blank to use collection name"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title Font Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 17,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Title Font Weight",
      "options": [
        {"value": "400", "label": "Normal"},
        {"value": "500", "label": "Medium"},
        {"value": "600", "label": "Semibold"},
        {"value": "700", "label": "Bold"}
      ],
      "default": "600"
    },
    {
      "type": "checkbox",
      "id": "show_back_button",
      "label": "Show Back Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Wishlist Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Cart Icon",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Collection Top Bar"
    }
  ]
}
{% endschema %}
