{% render 'category-visibility-wrapper',
  show_in_all_categories: section.settings.show_in_all_categories,
  category_only_show_for: section.settings.category_only_show_for,
  tag_type: 'open'
%}

{%- if section.settings.show_announcement -%}
  <style>
    #shopify-section-{{ section.id }} .announcement-bar {
      background-color: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
      overflow: hidden;
      white-space: nowrap;
      position: relative;
      padding: 12px 1.5rem;
      display: flex;
      align-items: center;
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .announcement-bar {
        padding: 12px 3.2rem;
      }
    }

    @media screen and (min-width: 990px) {
      #shopify-section-{{ section.id }} .announcement-bar {
        max-width: var(--page-width);
        margin: 0 auto;
        padding: 12px 1.5rem;
      }
    }

    #shopify-section-{{ section.id }} .announcement-bar__content {
      display: inline-flex;
      animation: marquee-{{ section.id }} {{ section.settings.speed }}s linear infinite;
      min-width: 100%;
    }

    #shopify-section-{{ section.id }} .announcement-bar:hover .announcement-bar__content {
      animation-play-state: paused;
    }

    #shopify-section-{{ section.id }} .announcement-bar__item {
      display: inline-flex;
      align-items: center;
      padding: 0 40px;
    }

    #shopify-section-{{ section.id }} .announcement-bar__link {
      color: inherit;
      text-decoration: none;
      font-weight: 500;
      font-size: 14px;
      letter-spacing: 0.5px;
      transition: opacity 0.2s;
    }

    #shopify-section-{{ section.id }} .announcement-bar__link:hover {
      opacity: 0.8;
    }

    @keyframes marquee-{{ section.id }} {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-100%);
      }
    }
  </style>

  <div class="announcement-bar" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
    {%- comment -%}
      We render the blocks twice to create a seamless infinite scroll effect.
      The animation moves the entire strip to the left by 100% of its width,
      then instantly resets to 0, creating the loop.
    {%- endcomment -%}

    {%- capture announcement_content -%}
      {%- for block in section.blocks -%}
        <div class="announcement-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="announcement-bar__link">
              {{ block.settings.text | escape }}
            </a>
          {%- else -%}
            <span class="announcement-bar__link">
              {{ block.settings.text | escape }}
            </span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endcapture -%}

    {%- if section.blocks.size > 0 -%}
      <div class="announcement-bar__content">
        {{ announcement_content }}
        {%- comment -%}Duplicate content for seamless scrolling{%- endcomment -%}
        {{ announcement_content }}
        {{ announcement_content }}
        {{ announcement_content }}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% render 'category-visibility-wrapper', tag_type: 'close' %}

{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 3,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1e293b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#f8fafc"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll speed",
      "default": 25
    },
    {
      "type": "header",
      "content": "Category visibility"
    },
    {
      "type": "checkbox",
      "id": "show_in_all_categories",
      "label": "Show in all categories",
      "default": true
    },
    {
      "type": "select",
      "id": "category_only_show_for",
      "label": "Show only for",
      "options": [
        {
          "value": "men",
          "label": "Men"
        },
        {
          "value": "women",
          "label": "Women"
        }
      ],
      "default": "men",
      "info": "Used when the section should appear for a single category."
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Welcome to our store"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Free shipping on all orders over 599"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "New arrivals are here! Shop now"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Sign up for our newsletter"
          }
        }
      ]
    }
  ]
}
{% endschema %}
