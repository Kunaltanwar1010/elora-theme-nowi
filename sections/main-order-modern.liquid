{{ 'tailwind.css' | asset_url | stylesheet_tag }}
{{ 'account-modern.css' | asset_url | stylesheet_tag }}
<script src="{{ 'account-modern.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign has_tracking = false
  assign tracking_url = ''
  assign awb_number = ''
  assign courier_name = ''

  # Get tracking data from line_item.fulfillment (where Shopify stores tracking info)
  for line_item in order.line_items
    if line_item.fulfillment
      if line_item.fulfillment.tracking_number != blank
        assign has_tracking = true
        assign awb_number = line_item.fulfillment.tracking_number
        assign tracking_url = line_item.fulfillment.tracking_url
        assign courier_name = line_item.fulfillment.tracking_company
        break
      elsif line_item.fulfillment.tracking_url != blank
        assign has_tracking = true
        assign tracking_url = line_item.fulfillment.tracking_url
        assign courier_name = line_item.fulfillment.tracking_company
        break
      endif
    endif
  endfor

  # Check order status from tags (same logic as order card)
  assign order_tags_lower = order.tags | downcase
  assign is_delivered = false
  assign is_out_for_delivery = false
  assign is_shipped = false
  if order_tags_lower contains 'delivered'
    assign is_delivered = true
  elsif order_tags_lower contains 'out for delivery'
    assign is_out_for_delivery = true
  elsif order_tags_lower contains 'shipped' or order_tags_lower contains 'in transit'
    assign is_shipped = true
  elsif order.fulfillment_status == 'fulfilled' or order.fulfillment_status == 'partial'
    assign is_shipped = true
  endif

  # Check if we can show tracking (shipped or beyond)
  assign can_show_tracking = false
  if is_shipped or is_out_for_delivery or is_delivered
    assign can_show_tracking = true
  endif

  # Calculate return window (7 days from delivery date)
  assign return_close_date = ''
  assign can_return = false
  assign return_url = 'https://nowi.fashion/apps/ezy/returns'
  if is_delivered and order.cancelled == false
    # Use delivery_date metafield set by Shopify Flow
    assign delivery_date = order.metafields.custom.delivery_date.value
    if delivery_date != blank
      assign delivered_timestamp = delivery_date | date: '%s' | plus: 0
      assign return_close_timestamp = delivered_timestamp | plus: 604800
      assign return_close_date = return_close_timestamp | date: '%a, %d %b'
      assign now_timestamp = 'now' | date: '%s' | plus: 0
      if now_timestamp < return_close_timestamp
        assign can_return = true
      endif
    endif
  endif

  # Build line items JSON for reorder
  assign line_items_json = ''
  for line_item in order.line_items
    assign item_json = '{"id":' | append: line_item.variant_id | append: ',"quantity":' | append: line_item.quantity | append: '}'
    if forloop.first == false
      assign line_items_json = line_items_json | append: ','
    endif
    assign line_items_json = line_items_json | append: item_json
  endfor
  assign line_items_json = '[' | append: line_items_json | append: ']'

  # We switched couriers to Shiprocket in July 2026. Orders from the cutoff onwards
  # carry a Shiprocket AWB, so they link to Shiprocket's branded tracking page.
  # Older orders pre-date it -- their AWB is not in Shiprocket's system and would
  # render an "AWB Not Found" page, so they keep the courier URL Shopify already stored.
  assign shiprocket_cutoff = '2026-07-01' | date: '%s' | plus: 0
  assign order_placed_at = order.created_at | date: '%s' | plus: 0

  assign track_link = tracking_url
  if order_placed_at >= shiprocket_cutoff and awb_number != blank
    assign track_link = 'https://shiprocket.co/tracking/' | append: awb_number
  endif
-%}

<div class="order-modern section-{{ section.id }}-padding">
  <div class="page-width px-4 lg:px-6">
    <!-- Header -->
    <div class="flex items-center justify-between mb-4">
      <a
        href="{{ routes.account_url }}"
        class="account-btn account-btn-secondary account-btn-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Back to Account</span>
      </a>
    </div>

    <!-- Tracking Card -->
    <div class="account-card p-5 mb-6">
      <!-- Order Info Row -->
      <div class="flex items-center justify-between flex-wrap gap-2 mb-5 pb-4" style="border-bottom: 1px solid var(--account-border-light);">
        <div>
          <h2 class="account-h2">{{ order.name }}</h2>
          <span class="account-overline">{{ order.created_at | date: '%b %d, %Y' }}</span>
        </div>
        <div class="flex items-center gap-1.5">
          {% render 'account-order-status-badge', order: order %}
          {% render 'account-order-status-badge', order: order, type: 'payment' %}
        </div>
      </div>

      {%- if order.cancelled -%}
        <!-- Cancelled State -->
        {% render 'order-tracking-steps', order: order %}
        {%- if order.cancel_reason_label != blank -%}
          <p class="mt-4 account-body-sm">{{ order.cancel_reason_label }}</p>
        {%- endif -%}
      {%- else -%}
        <!-- Step Tracker (hide_status_text since badges already show status) -->
        {% render 'order-tracking-steps', order: order, hide_status_text: true %}

        <!-- Tracking Action -->
        {%- if track_link != blank -%}
          <div class="mt-5">
            <a
              href="{{ track_link }}"
              target="_blank"
              rel="noopener noreferrer"
              class="account-btn account-btn-primary w-full"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Track Shipment
            </a>
          </div>
        {%- endif -%}

        <!-- AWB Info (if available) -->
        {%- if awb_number != blank -%}
          <div class="mt-3 flex items-center gap-2 account-body-sm">
            <span>AWB: <span class="font-medium" style="color: var(--account-text-secondary);">{{ awb_number }}</span></span>
            {%- if courier_name != blank -%}
              <span style="color: var(--account-border-medium);">•</span>
              <span>{{ courier_name }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- endif -%}
    </div>

    <!-- Items Card -->
    <div class="account-card overflow-hidden mb-6">
      <div class="px-5 py-4" style="border-bottom: 1px solid var(--account-border-light);">
        <h3 class="account-caption">
          Items ({{ order.line_items.size }})
        </h3>
      </div>

      <div class="divide-y" style="border-color: var(--account-border-light);">
        {%- for line_item in order.line_items -%}
          <div class="p-5 flex gap-4" style="border-color: var(--account-border-light);">
            <!-- Product Image -->
            <a href="{{ line_item.url | default: line_item.product.url }}" class="w-16 h-20 rounded-xl overflow-hidden shrink-0 block" style="background: var(--account-bg-secondary); border: 1px solid var(--account-border-light);">
              {%- if line_item.image -%}
                <img
                  src="{{ line_item.image | image_url: width: 200 }}"
                  alt="{{ line_item.title | escape }}"
                  width="64"
                  height="80"
                  class="w-full h-full object-cover"
                  loading="lazy"
                >
              {%- else -%}
                <div class="w-full h-full flex items-center justify-center">
                  <svg class="w-6 h-6" style="color: var(--account-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              {%- endif -%}
            </a>

            <!-- Product Details -->
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  {%- if line_item.url != blank -%}
                    <a href="{{ line_item.url }}" class="account-h3 hover:opacity-80 line-clamp-2 block">
                      {{ line_item.title | escape }}
                    </a>
                  {%- else -%}
                    <p class="account-h3 line-clamp-2">{{ line_item.title | escape }}</p>
                  {%- endif -%}

                  <!-- Variant Info -->
                  {%- unless line_item.product.has_only_default_variant -%}
                    <p class="account-body-sm mt-1">Size: {{ line_item.variant.title | escape }}</p>
                  {%- endunless -%}

                  <!-- Properties -->
                  {%- assign property_size = line_item.properties | size -%}
                  {%- if property_size > 0 -%}
                    <div class="mt-1.5 space-y-0.5">
                      {%- for property in line_item.properties -%}
                        {% assign property_first_char = property.first | slice: 0 %}
                        {%- if property.last != blank and property_first_char != '_' -%}
                          <p class="account-body-sm">
                            {{ property.first }}:
                            {%- if property.last contains '/uploads/' -%}
                              <a href="{{ property.last }}" class="underline" style="color: var(--account-text-secondary);">{{ property.last | split: '/' | last }}</a>
                            {%- else -%}
                              {{ property.last }}
                            {%- endif -%}
                          </p>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  <p class="account-body-sm mt-1.5">Qty: {{ line_item.quantity }}</p>
                </div>

                <!-- Price -->
                <div class="text-right shrink-0">
                  {%- if line_item.original_line_price != line_item.final_line_price -%}
                    <p class="account-body-sm line-through">{{ line_item.original_line_price | money }}</p>
                    <p class="account-h3" style="color: var(--account-status-success);">{{ line_item.final_line_price | money }}</p>
                  {%- else -%}
                    <p class="account-h3">{{ line_item.final_line_price | money }}</p>
                  {%- endif -%}
                </div>
              </div>

              <!-- Line Item Discounts -->
              {%- if line_item.line_level_discount_allocations != blank -%}
                <div class="mt-3 flex flex-wrap gap-2">
                  {%- for discount_allocation in line_item.line_level_discount_allocations -%}
                    <span class="account-badge account-badge-success">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                      </svg>
                      {{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})
                    </span>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <!-- Fulfillment Info -->
              {%- if line_item.fulfillment -%}
                <div class="mt-3 p-3 rounded-lg" style="background: var(--account-bg-secondary);">
                  <p class="account-body-sm">
                    <span class="font-medium">Shipped:</span> {{ line_item.fulfillment.created_at | date: '%b %d, %Y' }}
                    {%- if line_item.fulfillment.tracking_company != blank %}
                      via {{ line_item.fulfillment.tracking_company }}
                    {%- endif -%}
                  </p>
                  {%- if line_item.fulfillment.tracking_url -%}
                    <a
                      href="{{ line_item.fulfillment.tracking_url }}"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="account-body-sm font-medium hover:underline mt-1 inline-block"
                      style="color: var(--account-text-primary);"
                    >
                      Track this item →
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <!-- Review Button (for delivered orders) - Shows popup to check email -->
              {%- if is_delivered -%}
                <div class="mt-4">
                  <button
                    type="button"
                    class="review-email-btn account-btn account-btn-accent account-btn-sm"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    Rate & Review
                  </button>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- Order Summary Card -->
    <div class="account-card p-5 mb-6">
      <h3 class="account-caption mb-4">Order Summary</h3>

      <div class="space-y-3">
        <!-- Subtotal -->
        <div class="flex items-center justify-between">
          <span class="account-body-sm">Subtotal</span>
          <span class="account-body" style="color: var(--account-text-primary);">{{ order.line_items_subtotal_price | money }}</span>
        </div>

        <!-- Cart Level Discounts -->
        {%- if order.cart_level_discount_applications != blank -%}
          {%- for discount_application in order.cart_level_discount_applications -%}
            <div class="flex items-center justify-between">
              <span class="account-body-sm flex items-center gap-1.5" style="color: var(--account-status-success);">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                </svg>
                {{ discount_application.title }}
              </span>
              <span class="account-body-sm" style="color: var(--account-status-success);">-{{ discount_application.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
        {%- endif -%}

        <!-- Shipping -->
        {%- for shipping_method in order.shipping_methods -%}
          <div class="flex items-center justify-between">
            <span class="account-body-sm">Shipping ({{ shipping_method.title }})</span>
            <span class="account-body" style="color: var(--account-text-primary);">
              {%- if shipping_method.price == 0 -%}
                FREE
              {%- else -%}
                {{ shipping_method.price | money }}
              {%- endif -%}
            </span>
          </div>
        {%- endfor -%}

        <!-- Taxes -->
        {%- for tax_line in order.tax_lines -%}
          <div class="flex items-center justify-between">
            <span class="account-body-sm">{{ tax_line.title }} ({{ tax_line.rate | times: 100 }}%)</span>
            <span class="account-body" style="color: var(--account-text-primary);">{{ tax_line.price | money }}</span>
          </div>
        {%- endfor -%}

        <!-- Duties -->
        {%- if order.total_duties -%}
          <div class="flex items-center justify-between">
            <span class="account-body-sm">Duties</span>
            <span class="account-body" style="color: var(--account-text-primary);">{{ order.total_duties | money }}</span>
          </div>
        {%- endif -%}

        <!-- Refund -->
        {%- if order.total_refunded_amount > 0 -%}
          <div class="flex items-center justify-between">
            <span class="account-body-sm">Refunded</span>
            <span class="account-body-sm" style="color: var(--account-status-error);">-{{ order.total_refunded_amount | money }}</span>
          </div>
        {%- endif -%}

        <!-- Total -->
        <div class="pt-3" style="border-top: 1px solid var(--account-border-medium);">
          <div class="flex items-center justify-between">
            <span class="account-h2">Total</span>
            <span class="account-h2">{{ order.total_net_amount | money_with_currency }}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Addresses Card -->
    <div class="account-card p-5 mb-6">
      <h3 class="account-caption mb-4">Address</h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Shipping Address -->
        <div class="p-4 rounded-xl" style="background: var(--account-bg-secondary);">
          <div class="flex items-center gap-1.5 mb-2">
            <svg class="w-4 h-4" style="color: var(--account-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 4H6a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-2m-4-1v8m0 0l3-3m-3 3L9 8m-5 5h2.586a1 1 0 01.707.293l2.414 2.414a1 1 0 00.707.293h3.172a1 1 0 00.707-.293l2.414-2.414a1 1 0 01.707-.293H20" />
            </svg>
            <span class="account-overline">Shipping</span>
          </div>
          <div class="account-body-sm" style="color: var(--account-text-primary); line-height: 1.6;">
            {{ order.shipping_address | format_address }}
          </div>
        </div>

        <!-- Billing Address -->
        <div class="p-4 rounded-xl" style="background: var(--account-bg-secondary);">
          <div class="flex items-center gap-1.5 mb-2">
            <svg class="w-4 h-4" style="color: var(--account-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
            <span class="account-overline">Billing</span>
          </div>
          <div class="account-body-sm" style="color: var(--account-text-primary); line-height: 1.6;">
            {{ order.billing_address | format_address }}
          </div>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    {%- unless order.cancelled -%}
      <div class="account-card p-5 mb-6">
        <h3 class="account-caption mb-3">Quick Actions</h3>
        <div class="flex flex-wrap gap-2">
          <!-- Reorder Button -->
          <button
            type="button"
            class="account-btn account-btn-primary account-btn-sm reorder-btn"
            data-order-id="{{ order.id }}"
            data-line-items="{{ line_items_json | escape }}"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Reorder
          </button>

          {%- if is_delivered and can_return -%}
            <a
              href="{{ return_url }}"
              target="_blank"
              rel="noopener noreferrer"
              class="account-btn account-btn-secondary account-btn-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 15v-1a4 4 0 00-4-4H8m0 0l3 3m-3-3l3-3m9 14V5a2 2 0 00-2-2H6a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z" />
              </svg>
              Return/Exchange
            </a>
          {%- endif -%}
        </div>

        {%- if is_delivered and return_close_date != blank -%}
          <p class="account-body-sm mt-3 flex items-center gap-2">
            <span class="w-1 h-1 rounded-full" style="background: var(--account-text-muted);"></span>
            {%- if can_return -%}
              Exchange/Return window closes on {{ return_close_date }}
            {%- else -%}
              Exchange/Return window closed on {{ return_close_date }}
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>
    {%- endunless -%}
  </div>
</div>

<!-- Review Email Modal -->
<div
  id="ReviewEmailModal"
  class="review-email-modal"
  style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9999; background-color: rgba(11, 18, 32, 0.5);"
  aria-hidden="true"
  role="dialog"
>
  <div class="flex items-center justify-center min-h-full p-4">
    <div class="account-card max-w-sm w-full p-6 text-center" style="transform: scale(0.95); opacity: 0; transition: transform 0.2s ease, opacity 0.2s ease;" id="ReviewEmailModalContent">
      <!-- Email Icon -->
      <div class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center" style="background-color: var(--account-accent-soft);">
        <svg class="w-8 h-8" style="color: var(--account-accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </div>

      <!-- Title -->
      <h3 class="account-h1 mb-2">Check Your Email</h3>

      <!-- Message -->
      <p class="account-body mb-6">
        We've sent you a review link. Look for an email from Judge.me to share your feedback.
      </p>

      <!-- Button -->
      <button
        type="button"
        id="ReviewEmailModalClose"
        class="account-btn account-btn-primary w-full"
      >
        Got it
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    const modal = document.getElementById('ReviewEmailModal');
    const content = document.getElementById('ReviewEmailModalContent');
    const closeBtn = document.getElementById('ReviewEmailModalClose');

    function openModal() {
      modal.style.display = 'block';
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        content.style.transform = 'scale(1)';
        content.style.opacity = '1';
      });
    }

    function closeModal() {
      content.style.transform = 'scale(0.95)';
      content.style.opacity = '0';
      setTimeout(() => {
        modal.style.display = 'none';
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }, 200);
    }

    // Bind all review buttons
    document.querySelectorAll('.review-email-btn').forEach(btn => {
      btn.addEventListener('click', openModal);
    });

    // Close button
    closeBtn?.addEventListener('click', closeModal);

    // Close on backdrop click
    modal?.addEventListener('click', (e) => {
      if (e.target === modal || e.target.classList.contains('flex')) {
        closeModal();
      }
    });

    // Close on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.style.display !== 'none') {
        closeModal();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Order Page (Modern)",
  "tag": "section",
  "class": "section",
  "settings": [
