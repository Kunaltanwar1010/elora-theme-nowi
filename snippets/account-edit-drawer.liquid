{% comment %}
  Renders an edit profile popup modal

  Usage:
  {% render 'account-edit-drawer' %}
{% endcomment %}

<!-- Modal Overlay -->
<div
  id="EditProfileModal"
  style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9999; background-color: rgba(0, 0, 0, 0.5);"
  aria-hidden="true"
  role="dialog"
>
  <!-- Modal Content -->
  <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; padding: 24px;">
    <div
      id="EditProfileModalContent"
      class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-6"
      style="transform: scale(0.95); opacity: 0; transition: all 0.3s ease;"
    >
    <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-amber-100 flex items-center justify-center">
      <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
      </svg>
    </div>

    <h2 class="text-[18px] font-semibold text-gray-900 text-center mb-3">Edit Profile</h2>

    <p class="text-[14px] text-gray-600 text-center mb-6">
      To update your profile details, please contact us at
      <a href="mailto:info@nowi.fashion" class="text-gray-900 font-medium underline">info@nowi.fashion</a>
    </p>

      <button
        type="button"
        id="EditProfileCloseBtn"
        class="w-full py-3 px-5 bg-gray-900 text-white text-[14px] font-medium rounded-xl hover:bg-gray-800 transition-colors"
      >
        Got it
      </button>
    </div>
  </div>
</div>
