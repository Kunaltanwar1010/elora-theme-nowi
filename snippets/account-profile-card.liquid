{% comment %}
  Renders a modern profile card with hero banner, enhanced avatar, and address section
  Modern Editorial style with navy + warm cream color palette

  Accepts:
  - customer: {Object} Customer Liquid object (required)
  - hide_logout: {Boolean} Hide logout link (default: false) - use when sidebar shows logout

  Usage:
  {% render 'account-profile-card', customer: customer %}
  {% render 'account-profile-card', customer: customer, hide_logout: true %}
{% endcomment %}

{%- liquid
  assign hide_logout = hide_logout | default: false

  assign initials = ''
  if customer.first_name != blank
    assign first_initial = customer.first_name | slice: 0 | upcase
    assign initials = first_initial
  endif
  if customer.last_name != blank
    assign last_initial = customer.last_name | slice: 0 | upcase
    assign initials = initials | append: last_initial
  endif
  if initials == blank and customer.email != blank
    assign initials = customer.email | slice: 0 | upcase
  endif
  if initials == blank
    assign initials = 'U'
  endif

  assign display_name = customer.first_name | append: ' ' | append: customer.last_name | strip
  if display_name == blank
    assign display_name = customer.email | split: '@' | first
  endif
-%}

<div class="account-card overflow-hidden">
  <!-- Hero Banner -->
  <div class="account-profile-hero">
    <!-- Decorative accent line -->
    <div class="absolute bottom-0 left-0 right-0 h-1" style="background: linear-gradient(90deg, var(--account-accent) 0%, transparent 60%);"></div>
  </div>

  <!-- Profile Content - Overlaps banner -->
  <div class="relative px-5 pb-5 -mt-10">
    <div class="flex items-end gap-4">
      <!-- Enhanced Avatar with Ring -->
      <div class="relative">
        <div class="account-avatar-ring">
          <div class="account-avatar-inner">
            {{ initials }}
          </div>
        </div>
        <!-- Verified Badge -->
        <div class="account-avatar-badge">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
          </svg>
        </div>
      </div>

      <!-- Edit Button - Navy primary -->
      <button
        type="button"
        id="EditProfileBtn"
        class="account-btn account-btn-primary account-btn-sm ml-auto"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
        </svg>
        Edit
      </button>
    </div>

    <!-- User Info -->
    <div class="mt-4">
      <h2 class="account-h1">{{ display_name }}</h2>
      <p class="account-body-sm mt-1">{{ customer.email }}</p>
      {%- if customer.phone != blank -%}
        <p class="account-body-sm mt-0.5" style="color: var(--account-text-light);">{{ customer.phone }}</p>
      {%- endif -%}
    </div>
  </div>

  <!-- Address Section -->
  <a
    href="{{ routes.account_addresses_url }}"
    class="group block border-t transition-colors hover:bg-[#FAFAFA]/50"
    style="border-color: var(--account-border-light); background: var(--account-bg-secondary);"
  >
    <div class="px-5 py-4">
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1 min-w-0">
          <!-- Label with icon -->
          <div class="flex items-center gap-2 mb-2">
            <svg class="w-4 h-4 shrink-0" style="color: var(--account-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="account-overline">Default Address</span>
            {%- if customer.default_address -%}
              <span class="account-badge account-badge-accent">Primary</span>
            {%- endif -%}
          </div>

          <!-- Address Text -->
          {%- if customer.default_address -%}
            <p class="account-body line-clamp-2" style="color: var(--account-text-primary);">
              {{ customer.default_address.address1 }}{% if customer.default_address.address2 != blank %}, {{ customer.default_address.address2 }}{% endif %},
              {{ customer.default_address.city }}{% if customer.default_address.province != blank %}, {{ customer.default_address.province }}{% endif %}
            </p>
          {%- else -%}
            <p class="account-body italic" style="color: var(--account-text-light);">No address saved yet</p>
          {%- endif -%}
        </div>

        <!-- Arrow with count -->
        <div class="flex items-center gap-3 shrink-0 pt-1">
          <span class="account-caption" style="color: var(--account-text-light);">{{ customer.addresses_count }}</span>
          <svg class="w-5 h-5 account-arrow-icon" style="color: var(--account-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </div>
    </div>
  </a>

  <!-- Logout Button (mobile only - hidden when sidebar is present) -->
  {%- unless hide_logout -%}
    <a
      href="{{ routes.account_logout_url }}"
      class="lg:hidden flex items-center gap-2 px-5 py-4 border-t transition-colors hover:bg-red-50"
      style="border-color: var(--account-border-light); color: var(--account-status-error);"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      <span class="account-body" style="font-weight: 500; color: inherit;">{{ 'customer.log_out' | t }}</span>
    </a>
  {%- endunless -%}
</div>

<!-- Edit Profile Modal -->
{% render 'account-edit-drawer' %}
