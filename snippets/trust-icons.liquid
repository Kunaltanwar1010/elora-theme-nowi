{%- comment -%}
  Preset trust-badge icons for the trust marquee.
  Usage: {% render 'trust-icons', icon: block.settings.icon_key, size: 28 %}
  Line style: 24x24 viewBox, 1.5px stroke, stroke="currentColor" so the icon
  inherits the section's icon colour (maroon by default). A merchant-uploaded
  image overrides these (handled in the section, not here).
{%- endcomment -%}
{%- liquid
  assign s = size | default: 28
-%}
<span class="trust-icon" style="display:inline-flex;width:{{ s }}px;height:{{ s }}px;">
{%- case icon -%}
  {%- when 'free_shipping' -%}
    <svg viewBox="0 0 24 24" fill="none" width="{{ s }}" height="{{ s }}" aria-hidden="true">
      <path d="M1.5 6.5h11v9h-11z M12.5 9.5h4l3 3v3h-7z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="6" cy="17.5" r="1.75" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="16.5" cy="17.5" r="1.75" stroke="currentColor" stroke-width="1.5"/>
    </svg>
  {%- when 'cod' -%}
    <svg viewBox="0 0 24 24" fill="none" width="{{ s }}" height="{{ s }}" aria-hidden="true">
      <rect x="2.5" y="6.5" width="19" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
      <path d="M9.5 9.5h5 M9.5 12h5 M12 9.5c1.6 0 2.4 4.5-1 4.5l3 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'exchange' -%}
    <svg viewBox="0 0 24 24" fill="none" width="{{ s }}" height="{{ s }}" aria-hidden="true">
      <path d="M4 9a7 7 0 0 1 12-2m0 0V4m0 3h-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M20 15a7 7 0 0 1-12 2m0 0v3m0-3h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'secure_payment' -%}
    <svg viewBox="0 0 24 24" fill="none" width="{{ s }}" height="{{ s }}" aria-hidden="true">
      <rect x="4.5" y="10.5" width="15" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
      <path d="M7.5 10.5V8a4.5 4.5 0 0 1 9 0v2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="12" cy="15" r="1.25" fill="currentColor"/>
    </svg>
  {%- when 'quality' -%}
    <svg viewBox="0 0 24 24" fill="none" width="{{ s }}" height="{{ s }}" aria-hidden="true">
      <path d="M12 2.5l2.6 1.9 3.2-.2 1 3 2.6 1.9-1.2 3 1.2 3-2.6 1.9-1 3-3.2-.2L12 24.5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" transform="scale(0.85) translate(2,0)"/>
      <path d="M9 12l2.2 2.2L15.5 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'made_in_india' -%}
    <svg viewBox="0 0 24 24" fill="none" width="{{ s }}" height="{{ s }}" aria-hidden="true">
      <path d="M12 21.5s-7-4.4-7-9.9a7 7 0 0 1 14 0c0 5.5-7 9.9-7 9.9z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="12" cy="11.5" r="2.25" stroke="currentColor" stroke-width="1.5"/>
    </svg>
  {%- when 'support' -%}
    <svg viewBox="0 0 24 24" fill="none" width="{{ s }}" height="{{ s }}" aria-hidden="true">
      <path d="M5 13v-1a7 7 0 0 1 14 0v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <rect x="3.5" y="12.5" width="3.5" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
      <rect x="17" y="12.5" width="3.5" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
      <path d="M19 18.5v.5a3 3 0 0 1-3 3h-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'original' -%}
    <svg viewBox="0 0 24 24" fill="none" width="{{ s }}" height="{{ s }}" aria-hidden="true">
      <path d="M3.5 11.5l8-8 9 1 1 9-8 8-10-10z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="15.5" cy="8.5" r="1.5" stroke="currentColor" stroke-width="1.5"/>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" width="{{ s }}" height="{{ s }}" aria-hidden="true">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
      <path d="M9 12l2 2 4-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
{%- endcase -%}
</span>
