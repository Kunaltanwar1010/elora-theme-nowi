{% comment %}
  WhatsApp support chat bubble — fixed bottom-left (bottom-right is
  taken by sticky ATC / cart on mobile). Enabled via
  Theme Settings → Support & Conversion.
{% endcomment %}
{%- if settings.whatsapp_enable and settings.whatsapp_number != blank -%}
  <a
    class="whatsapp-bubble"
    href="https://wa.me/{{ settings.whatsapp_number | replace: '+', '' | replace: ' ', '' }}{% if settings.whatsapp_prefill != blank %}?text={{ settings.whatsapp_prefill | url_encode }}{% endif %}"
    target="_blank"
    rel="noopener"
    aria-label="Chat with us on WhatsApp"
  >
    <svg width="26" height="26" viewBox="0 0 32 32" fill="#fff" aria-hidden="true">
      <path d="M16 2.7C8.7 2.7 2.8 8.6 2.8 15.9c0 2.3.6 4.6 1.8 6.6L2.7 29.3l7-1.8c1.9 1 4.1 1.6 6.3 1.6 7.3 0 13.2-5.9 13.2-13.2S23.3 2.7 16 2.7zm0 24.1c-2 0-3.9-.5-5.6-1.5l-.4-.2-4.2 1.1 1.1-4-.3-.4c-1.1-1.8-1.7-3.8-1.7-5.9C4.9 9.8 9.9 4.9 16 4.9s11.1 5 11.1 11.1-5 10.8-11.1 10.8zm6.1-8.1c-.3-.2-2-1-2.3-1.1-.3-.1-.5-.2-.7.2-.2.3-.8 1.1-1 1.3-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.7-1.7-1-.9-1.7-2-1.9-2.3-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.6.1-.2 0-.4 0-.6-.1-.2-.7-1.8-1-2.4-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.7s1.2 3.2 1.4 3.4c.2.2 2.4 3.7 5.8 5.2.8.4 1.4.6 1.9.7.8.3 1.5.2 2.1.1.6-.1 2-.8 2.3-1.6.3-.8.3-1.5.2-1.6-.1-.2-.3-.3-.6-.4z"/>
    </svg>
  </a>
  <style>
    .whatsapp-bubble {
      position: fixed;
      bottom: 1.6rem;
      left: 1.6rem;
      z-index: 6;
      width: 5rem;
      height: 5rem;
      border-radius: 50%;
      background: #25D366;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
      transition: transform 0.2s ease;
    }
    .whatsapp-bubble:hover { transform: scale(1.08); }
    {%- if template.name == 'product' -%}
    @media (max-width: 749px) {
      /* Keep clear of the sticky add-to-cart bar on product pages */
      .whatsapp-bubble { bottom: 8.5rem; }
    }
    {%- endif -%}
  </style>
{%- endif -%}
