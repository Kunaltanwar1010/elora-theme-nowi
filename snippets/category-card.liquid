{% comment %}
  Renders a category card for the scrollable category carousel

  Accepts:
  - block: {Object} Section block object containing category settings
  - card_border_radius: {Number} Border radius for the card (from section settings)

  Usage:
  {% render 'category-card',
    block: block,
    card_border_radius: 20
  %}
{% endcomment %}

{% if block.settings.category_link != blank %}
  <a href="{{ block.settings.category_link }}" class="category-carousel-link">
{% endif %}

<div class="category-carousel-card">
  <!-- Card Image -->
  <div class="category-carousel-image">
    {% if block.settings.category_image %}
      <img
        srcset="
          {%- if block.settings.category_image.width >= 200 -%}{{ block.settings.category_image | image_url: width: 200 }} 200w,{%- endif -%}
          {%- if block.settings.category_image.width >= 300 -%}{{ block.settings.category_image | image_url: width: 300 }} 300w,{%- endif -%}
          {%- if block.settings.category_image.width >= 400 -%}{{ block.settings.category_image | image_url: width: 400 }} 400w,{%- endif -%}
          {%- if block.settings.category_image.width >= 500 -%}{{ block.settings.category_image | image_url: width: 500 }} 500w{%- endif -%}
        "
        src="{{ block.settings.category_image | image_url: width: 300 }}"
        sizes="(max-width: 480px) 35vw, (max-width: 768px) 25vw, 200px"
        alt="{{ block.settings.category_label | escape }}"
        loading="lazy"
        class="category-image"
        width="{{ block.settings.category_image.width }}"
        height="{{ block.settings.category_image.height }}"
      >
    {% else %}
      <div class="category-image-placeholder">
        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/>
          <path d="M3 15L8 10L12 14L17 9L21 13V19C21 20.1046 20.1046 21 19 21H5C3.89543 21 3 20.1046 3 19V15Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
      </div>
    {% endif %}
  </div>

  <!-- Card Content -->
  <div class="category-carousel-content">
    {% if block.settings.category_label %}
      <div class="category-carousel-label">
        <span class="category-label-text">{{ block.settings.category_label }}</span>
      </div>
    {% endif %}
    
    {% if block.settings.category_subtitle %}
      <div class="category-carousel-subtitle">
        <span class="category-subtitle-text">{{ block.settings.category_subtitle }}</span>
      </div>
    {% endif %}
  </div>
</div>

{% if block.settings.category_link != blank %}
  </a>
{% endif %}
