{% comment %}
  Renders opening and closing tags for category-based visibility control.

  This snippet provides category-based visibility control for homepage sections.
  Sections can be shown in all categories or restricted to a specific category.

  Accepts:
  - show_in_all_categories: {Boolean} Whether to show in all categories (default: true)
  - category_only_show_for: {String} Category key to show for (e.g., 'men', 'women')
  - tag_type: {String} 'open' or 'close' - which tag to render

  Usage:
  {% render 'category-visibility-wrapper',
    show_in_all_categories: section.settings.show_in_all_categories,
    category_only_show_for: section.settings.category_only_show_for,
    tag_type: 'open'
  %}
    <!-- Your section content here -->
  {% render 'category-visibility-wrapper', tag_type: 'close' %}
{% endcomment %}

{%- if tag_type == 'close' -%}
</div>
{%- else -%}
  {%- liquid
    assign category_scope = 'all'
    if show_in_all_categories != true
      assign category_scope = category_only_show_for | default: 'men'
    endif
  -%}
<div class="category-controlled-section" data-category-scope="{{ category_scope }}">
{%- endif -%}
