{% comment %}
  Renders a trending card for use in carousel or grid layouts

  Accepts:
  - block: {Object} Section block object containing card settings
  - section: {Object} Section object containing global settings
  - card_border_radius: {Number} Border radius for the card (from section settings)

  Usage:
  {% render 'trending-card',
    block: block,
    section: section,
    card_border_radius: section.settings.card_border_radius
  %}
{% endcomment %}

{% if block.settings.card_link != blank %}
  <a href="{{ block.settings.card_link }}" class="trending-card-link">
{% endif %}
<div class="trending-card" style="border-radius: {{ card_border_radius }}px;">
  <!-- Card Image -->
  <div class="trending-card-image" style="border-radius: {{ card_border_radius }}px;">
    {% if block.settings.card_image %}
      <img
        srcset="
          {%- if block.settings.card_image.width >= 375 -%}{{ block.settings.card_image | image_url: width: 375 }} 375w,{%- endif -%}
          {%- if block.settings.card_image.width >= 500 -%}{{ block.settings.card_image | image_url: width: 500 }} 500w,{%- endif -%}
          {%- if block.settings.card_image.width >= 750 -%}{{ block.settings.card_image | image_url: width: 750 }} 750w,{%- endif -%}
          {%- if block.settings.card_image.width >= 1000 -%}{{ block.settings.card_image | image_url: width: 1000 }} 1000w{%- endif -%}
        "
        src="{{ block.settings.card_image | image_url: width: 500 }}"
        sizes="(max-width: 768px) 50vw, 25vw"
        alt="{{ block.settings.card_title | escape }}"
        loading="lazy"
        class="card-image"
        width="{{ block.settings.card_image.width }}"
        height="{{ block.settings.card_image.height }}"
      >
    {% else %}
      <div class="card-image-placeholder">No Image</div>
    {% endif %}
  </div>

  <!-- Card Overlay -->
  <div class="trending-card-overlay">
    <div class="trending-card-content">
      {% if block.settings.card_title %}
        <h3 class="trending-card-title">{{ block.settings.card_title }}</h3>
      {% endif %}

      {% if block.settings.card_link != blank %}
        <span class="trending-card-button">
          {{ block.settings.button_text }}
        </span>
      {% endif %}
    </div>
  </div>
</div>
{% if block.settings.card_link != blank %}
  </a>
{% endif %}
