{% comment %}
  Renders a modern address card with actions
  Modern Editorial style with navy + warm cream color palette

  Accepts:
  - address: {Object} Address Liquid object (required)
  - is_default: {Boolean} Whether this is the default address
  - index: {Number} Index for accessibility labels

  Usage:
  {% render 'account-address-card', address: address, is_default: true, index: 1 %}
{% endcomment %}

<div class="account-card overflow-hidden flex flex-col" data-address-card="{{ address.id }}">
  <!-- Address Content -->
  <div class="p-4 md:p-5 flex-1 relative">
    <!-- Default Badge -->
    {%- if is_default -%}
      <div class="absolute top-4 right-4">
        <span class="account-badge account-badge-accent">Default</span>
      </div>
    {%- endif -%}

    <!-- Name -->
    <p class="account-h2 mb-1 pr-16">
      {{ address.first_name }} {{ address.last_name }}
    </p>

    <!-- Company -->
    {%- if address.company != blank -%}
      <p class="account-body mb-1" style="color: var(--account-text-primary);">{{ address.company }}</p>
    {%- endif -%}

    <!-- Street Address -->
    <p class="account-body">{{ address.address1 }}</p>
    {%- if address.address2 != blank -%}
      <p class="account-body">{{ address.address2 }}</p>
    {%- endif -%}

    <!-- City, State, Zip -->
    <p class="account-body">
      {{ address.city }}{% if address.province != blank %}, {{ address.province }}{% endif %}{% if address.zip != blank %} {{ address.zip }}{% endif %}
    </p>

    <!-- Country -->
    <p class="account-body">{{ address.country }}</p>

    <!-- Phone -->
    {%- if address.phone != blank -%}
      <p class="account-body-sm mt-2 flex items-center gap-1.5">
        <svg class="w-4 h-4" style="color: var(--account-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {{ address.phone }}
      </p>
    {%- endif -%}
  </div>

  <!-- Actions -->
  <div class="px-4 py-3 flex flex-wrap items-center gap-2" style="background: var(--account-bg-secondary); border-top: 1px solid var(--account-border-light);">
    <button
      type="button"
      class="account-btn account-btn-primary account-btn-sm edit-address-btn"
      data-address-id="{{ address.id }}"
      aria-label="{{ 'customer.addresses.edit_address' | t }} {{ index }}"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
      </svg>
      Edit
    </button>

    <button
      type="button"
      class="account-btn account-btn-secondary account-btn-sm delete-address-btn"
      data-address-url="{{ address.url }}"
      data-delete-message="{{ 'customer.addresses.delete_confirm' | t }}"
      aria-label="{{ 'customer.addresses.delete' | t }} {{ index }}"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
      Delete
    </button>

    {%- unless is_default -%}
      {%- form 'customer_address', address, class: 'inline' -%}
        <input type="hidden" name="_method" value="put">
        <input type="hidden" name="address[default]" value="1">
        <input type="hidden" name="return_to" value="{{ routes.account_addresses_url }}">
        <button
          type="submit"
          class="account-btn account-btn-secondary account-btn-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
          </svg>
          Set as Default
        </button>
      {%- endform -%}
    {%- endunless -%}
  </div>

  <!-- Edit Form (Hidden) -->
  <div class="edit-address-form hidden" data-edit-form="{{ address.id }}" style="border-top: 1px solid var(--account-border-light);">
    <div class="p-4 md:p-5">
      <h3 class="account-h2 mb-4">Edit Address</h3>
      {%- form 'customer_address', address -%}
        {% render 'account-address-form', form: form, form_id: address.id %}
      {%- endform -%}
    </div>
  </div>
</div>
