{% comment %}
  Renders a size guide button

  Accepts:
  - section_id: {String} Section ID for unique identification
  - label: {String} Link text (optional, defaults to "Size Guide")

  Usage:
  {% render 'size-guide', section_id: section.id, label: block.settings.size_guide_label %}
{% endcomment %}

<button
  id="SizeGuideButton-{{ section_id }}"
  class="size-guide-button link"
  type="button"
  aria-haspopup="dialog"
  onclick="document.querySelector('#SizeGuideModal-{{ section_id }}').show(this)"
>

  <span class="size-guide-button__text">{{ label | default: 'Size Guide' }}</span>
</button>
